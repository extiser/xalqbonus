node_modules/
.nuxt/
.output/
# Клиент Prisma генерируется в дерево исходников (prisma/schema.prisma → generator.output).
server/generated/
dist/
.env
.env.*
!.env.example
*.log
logs/
.DS_Store
/data/
*.sql
# Наши собственные запросы правило выше закрывает заодно — возвращаем их в индекс.
!scripts/*.sql
# И миграции: без этого исключения migration.sql не попадает в коммит, а схема
# существует только на машине, где её сгенерировали.
!prisma/migrations/*/migration.sql

# дампы продовой базы
_backup/
*.dump

# выгрузки Fleet API: персональные данные парка, в репозиторий не попадают
_reference/fleet-api/dumps/

# байт-код питоновских скриптов разведки
__pycache__/
