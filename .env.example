# Образец `.env`. Здесь перечислены **все** переменные, которые читает приложение, воркер,
# docker compose и скрипты выката. Переменной, которой нет в этом файле, не существует:
# узнавать о ней из чужого `.env` — это как раз тот способ, которым переменные пропадают
# при переезде на новую машину.
#
# Пометка перед каждой переменной говорит, где она нужна:
#
#   [обе]      и локальный стенд, и боевая машина
#   [локально] только локальный стенд
#   [сервер]   только боевая машина
#
# Сам `.env` в репозиторий не попадает никогда: в нём боевые ключи.

# --- Приложение ---

# [обе] `development` локально, `production` на боевой машине. Локальный стек и так
# подставляет `development` поверх этого файла (docker/compose.local.yml).
NODE_ENV=development
# [обе] Порт внутри контейнера. Наружу local-стек публикует 3003, боевой — 127.0.0.1:3003.
PORT=3000
# [обе] Отметка живого цикла воркера: у него нет HTTP, и пробой служит возраст этого файла.
# Значение по умолчанию — `/tmp/worker-heartbeat`, и менять его нельзя, не поправив пробу
# в обоих compose-файлах: там путь записан строкой.
WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat

# --- PostgreSQL ---

# [обе] Имя базы, пользователь и пароль. Их читает контейнер базы при первом создании тома
# и они же стоят в строке подключения ниже.
POSTGRES_DB=xalqbonus
POSTGRES_USER=xalqbonus
POSTGRES_PASSWORD=changeme
# [обе] Строка подключения приложения и воркера. Хост `postgres` — имя контейнера в сети
# стека; с хоста та же база доступна на localhost:5434.
# `?schema=xb` обязателен: без него Prisma положит таблицу миграций _prisma_migrations
# в схему public, объявленную только читаемой.
DATABASE_URL=postgresql://xalqbonus:changeme@postgres:5432/xalqbonus?schema=xb
# [локально] Отдельная база под тесты, в том же контейнере. `make test` ходит только сюда
# и падает, если переменная не задана или имя базы не кончается на `_test`: тесты пишут
# настоящие переводы с общего эмиссионного счёта, и в рабочей базе с настоящим журналом им
# не место (docs/infra.md → «Тесты»). База заводится целью `make test-db`. На боевой машине
# тесты не гоняются, и обе переменные там не нужны.
POSTGRES_TEST_DB=xalqbonus_test
TEST_DATABASE_URL=postgresql://xalqbonus:changeme@postgres:5432/xalqbonus_test?schema=xb

# --- Redis (BullMQ) ---

# [обе] Очередь синхронизации и уведомлений. С хоста тот же Redis доступен на localhost:6381.
REDIS_URL=redis://redis:6379

# --- Yandex Fleet API ---

# [обе] Реквизиты парка. Пустые значения — рабочее состояние: приложение стартует,
# синхронизация падает на первом же прогоне с внятной строкой.
YANDEX_BASE_URL=https://fleet-api.taxi.yandex.net/
YANDEX_CLIENT_ID=
YANDEX_API_KEY=
YANDEX_PARK_ID=

# --- Синхронизация ---

# [обе] Выключатель повторяющейся задачи. `false` снимает расписание с очереди; разовый
# прогон целью `make sync-orders` работает независимо от него.
SYNC_LIVE_ENABLED=false
SYNC_LIVE_INTERVAL_SEC=60
# [обе] Перекрытие окна назад от отметки. Это и есть страховка от заказа, доехавшего до API
# позже, чем окно прошло его время завершения: повтор отсекается уникальностью заказа
# и ключом идемпотентности начисления, поэтому перекрывать дёшево.
SYNC_LIVE_OVERLAP_MIN=10
# [обе] Отставание верхней границы окна от текущего момента. Обязано быть заметно меньше
# перекрытия — иначе между окнами остаётся дыра, и прогон это проверяет на старте.
SYNC_LIVE_LAG_SEC=60
# [обе] Потолок ширины окна за один прогон. Воркер, простоявший неделю, иначе построил бы
# окно в неделю: полсотни страниц, отказы по лимиту и падение, после которого отметка стоит
# на месте и прогон повторяется вечно. С потолком остаток догоняется следующими прогонами.
SYNC_LIVE_MAX_WINDOW_MIN=360
# [обе] Сколько заказов запрашивается одной страницей.
SYNC_PAGE_LIMIT=500
# [обе] Сколько прогон может законно идти, прежде чем считаться оборванным. Строки `running`
# старше этого воркер закрывает при старте: SIGKILL не даёт прогону закрыть свою строку сам,
# и журнал прогонов начинает копить вечно бегущие строки. Значение — по самому долгому
# законному прогону: догоняющий за неделю идёт около часа.
SYNC_ABANDONED_RUN_MIN=180
# [обе] Нижняя граница порога, после которого отставание отметки — уже не задержка,
# а остановка синхронизации. Сам порог считается от интервала прогона (три интервала),
# но у минутного скользящего это три минуты, и жалоба на трёхминутное отставание была бы
# шумом. Значение назначается по суточному замеру живой синхронизации — до замера оно
# остаётся тем, с которым детектор написан.
SYNC_STALE_FLOOR_MIN=15

# [обе] Догоняющий прогон: раз в сутки перезапрашивается широкое окно. Заказ, провисевший
# в промежуточном статусе несколько дней, получает время завершения в прошлом, и если
# скользящее окно эту точку уже прошло, увидеть его больше нечем (docs/decisions.md).
SYNC_CATCHUP_ENABLED=false
SYNC_CATCHUP_INTERVAL_SEC=86400
SYNC_CATCHUP_DAYS=7

# [обе] Синхронизация профилей парка: инкрементальный прогон по `updated_at`. Свой
# выключатель и свой интервал — это единицы запросов в сутки, а не 4 062 в час у старого
# бота, и интервал выбирается из потребности, а не из экономии.
SYNC_REGISTRY_ENABLED=false
SYNC_REGISTRY_INTERVAL_SEC=3600
# [обе] Перекрытие окна профилей назад от отметки. Повтор безопасен: профиль обновляется
# по `profile_id`, а смена статуса пишется, только когда он действительно сменился.
# Этим же запасом полный обход отодвигает отметку назад от времени своего начала.
SYNC_REGISTRY_OVERLAP_MIN=60
# [обе] Отставание верхней границы окна профилей от текущего момента. Обязано быть заметно
# меньше перекрытия — иначе между окнами остаётся дыра, и прогон это проверяет на старте.
SYNC_REGISTRY_LAG_SEC=60
# Полный обход реестра нарезкой выключателя не имеет: он не ходит по расписанию вовсе
# и запускается командой `make sync-registry kind=registry_full`.

# --- Telegram ---

# [обе] Токен бота от @BotFather. Пустой токен — рабочее состояние: приложение стартует, бот
# не поднимается, в лог идёт предупреждение. Ботов три, и токен выбирает, кто именно
# отвечает: локальный, стендовый или боевой (docs/decisions.md → «Тестовых ботов два»).
# Им же проверяется подпись `initData` и строки контакта из Mini App: без токена сверять
# нечем, и запросы приложения падают с внятной строкой, а не с отказом в доступе.
TG_BOT_TOKEN=
# [обе] Режим доставки апдейтов: `polling` или `webhook`. Любое другое значение — отказ
# на старте, умолчания нет намеренно. У токена Telegram ровно один приёмник апдейтов,
# и `polling`, случайно доставшийся серверу, снял бы webhook у своего же токена молча,
# без ошибки. Локально — `polling`: наружу при нём ничего не открывается, домен и туннель
# не нужны.
TG_BOT_MODE=
# [сервер] Адрес, на который Telegram шлёт апдейты. Нужен только при `TG_BOT_MODE=webhook`:
# это домен машины плюс путь ручки, ровно `/api/tg/webhook` — под него на машине заведено
# правило nginx точным совпадением. На старте адрес сверяется с `getWebhookInfo`,
# и `setWebhook` вызывается только при расхождении.
TG_WEBHOOK_URL=
# [сервер] Значение заголовка `X-Telegram-Bot-Api-Secret-Token`: Telegram шлёт его с каждым
# апдейтом, приложение сверяет и отвечает 401 на несовпадение. Это единственная защита
# ручки — пароля nginx на ней нет и не будет. Генерируется `openssl rand -hex 32`, живёт
# в `.env` машины и в репозиторий не попадает. Обратно из `getWebhookInfo` не читается:
# такого поля в ответе нет, поэтому смена одного лишь секрета при том же адресе до Telegram
# не доедет — менять его нужно вместе с переустановкой webhook.
TG_WEBHOOK_SECRET=
# [сервер] Адрес Mini App — тот, что открывает кнопка под приветствием `/start`. Это домен
# машины плюс `/app`. Пусто — рабочее состояние: Telegram открывает Mini App только
# по `https`, а локальный стенд живёт на `http://localhost` и адреса снаружи не имеет вовсе.
# На такой машине `/start` отвечает одним приветствием, без кнопки, а приложение открывается
# кнопкой меню, заведённой в BotFather.
TG_MINIAPP_URL=

# --- Сотрудники парка ---

# [обе] Секрет подписи cookie сессии сотрудника. Таблицы сессий нет: cookie подписан этим
# секретом, а актуальность проверяется по базе на каждом запросе — `disabled_at` и
# `sessions_valid_from` (docs/decisions.md → «Учётка сотрудника и роли»). Отметку годности
# двигают выход из веба и смена пароля, поэтому отозвать сессии одного человека можно
# и без секрета; смена секрета разлогинивает всех разом.
# Генерируется `openssl rand -hex 32`, живёт в `.env` машины и в репозиторий не попадает.
# Пустое значение — не рабочее состояние: вход в веб при нём отказывает с внятной строкой.
EMPLOYEE_SESSION_SECRET=

# --- Выкат ---

# [сервер] Тег образа, на котором работает прод: точный short-SHA коммита, а не подвижное
# имя. Значение пишут сами скрипты выката и отката после зелёной проверки готовности
# (docker/scripts/_common.sh), руками строка не правится — иначе ближайший `make prod-up`
# поднимет не ту версию. Локальному стеку переменная не нужна: compose.local.yml собирает
# образ сам и тега не читает.
IMAGE_TAG=latest

# --- Входная дверь машины (docker/compose.proxy.yml) ---

# [сервер] Домен, на котором отдаётся приложение, и почта для Let's Encrypt. На боевой
# машине дверь — nginx хоста, и этот стек там не поднимается; переменные нужны на машинах,
# где дверь держит Caddy.
APP_DOMAIN=
CADDY_ACME_EMAIL=
# [сервер] Центр выдачи сертификатов. На обкатке —
# https://acme-staging-v02.api.letsencrypt.org/directory
CADDY_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
