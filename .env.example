# --- Приложение ---
NODE_ENV=development
# Порт внутри контейнера. Наружу local-стек публикует 3003 (docker/compose.local.yml).
PORT=3000

# --- PostgreSQL ---
# Хост `postgres` — имя контейнера в сети стека. С хоста та же база доступна на localhost:5434.
POSTGRES_DB=xalqbonus
POSTGRES_USER=xalqbonus
POSTGRES_PASSWORD=changeme
# `?schema=xb` обязателен: без него Prisma положит таблицу миграций _prisma_migrations
# в схему public, объявленную только читаемой.
DATABASE_URL=postgresql://xalqbonus:changeme@postgres:5432/xalqbonus?schema=xb
# Отдельная база под тесты, в том же контейнере. `make test` ходит только сюда и падает,
# если переменная не задана или имя базы не кончается на `_test`: тесты пишут настоящие
# переводы с общего эмиссионного счёта, и в рабочей базе с настоящим журналом им не место
# (docs/infra.md → «Тесты»). База заводится целью `make test-db`.
POSTGRES_TEST_DB=xalqbonus_test
TEST_DATABASE_URL=postgresql://xalqbonus:changeme@postgres:5432/xalqbonus_test?schema=xb

# --- Redis (BullMQ) ---
REDIS_URL=redis://redis:6379

# --- Yandex Fleet API ---
YANDEX_BASE_URL=https://fleet-api.taxi.yandex.net/
YANDEX_CLIENT_ID=
YANDEX_API_KEY=
YANDEX_PARK_ID=

# --- Синхронизация ---
SYNC_LIVE_ENABLED=false
SYNC_LIVE_INTERVAL_SEC=60
SYNC_LIVE_OVERLAP_MIN=10
SYNC_PAGE_LIMIT=500

# --- Telegram (этап 6) ---
TG_BOT_TOKEN=

# --- Входная дверь машины (docker/compose.proxy.yml, только на сервере) ---
APP_DOMAIN=
CADDY_ACME_EMAIL=
# На обкатке — https://acme-staging-v02.api.letsencrypt.org/directory
CADDY_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
