# --- Приложение ---
NODE_ENV=development
# Порт внутри контейнера. Наружу local-стек публикует 3003 (docker/compose.local.yml).
PORT=3000

# --- PostgreSQL ---
# Хост `postgres` — имя контейнера в сети стека. С хоста та же база доступна на localhost:5434.
POSTGRES_DB=xalqbonus
POSTGRES_USER=xalqbonus
POSTGRES_PASSWORD=changeme
# `?schema=xb` обязателен: без него Prisma положит таблицу миграций _prisma_migrations
# в схему public, объявленную только читаемой.
DATABASE_URL=postgresql://xalqbonus:changeme@postgres:5432/xalqbonus?schema=xb
# Отдельная база под тесты, в том же контейнере. `make test` ходит только сюда и падает,
# если переменная не задана или имя базы не кончается на `_test`: тесты пишут настоящие
# переводы с общего эмиссионного счёта, и в рабочей базе с настоящим журналом им не место
# (docs/infra.md → «Тесты»). База заводится целью `make test-db`.
POSTGRES_TEST_DB=xalqbonus_test
TEST_DATABASE_URL=postgresql://xalqbonus:changeme@postgres:5432/xalqbonus_test?schema=xb

# --- Redis (BullMQ) ---
REDIS_URL=redis://redis:6379

# --- Yandex Fleet API ---
YANDEX_BASE_URL=https://fleet-api.taxi.yandex.net/
YANDEX_CLIENT_ID=
YANDEX_API_KEY=
YANDEX_PARK_ID=

# --- Синхронизация ---
# Выключатель повторяющейся задачи. `false` снимает расписание с очереди; разовый прогон
# целью `make sync-orders` работает независимо от него.
SYNC_LIVE_ENABLED=false
SYNC_LIVE_INTERVAL_SEC=60
# Перекрытие окна назад от отметки. Это и есть страховка от заказа, доехавшего до API
# позже, чем окно прошло его время завершения: повтор отсекается уникальностью заказа
# и ключом идемпотентности начисления, поэтому перекрывать дёшево.
SYNC_LIVE_OVERLAP_MIN=10
# Отставание верхней границы окна от текущего момента. Обязано быть заметно меньше
# перекрытия — иначе между окнами остаётся дыра, и прогон это проверяет на старте.
SYNC_LIVE_LAG_SEC=60
# Потолок ширины окна за один прогон. Воркер, простоявший неделю, иначе построил бы окно
# в неделю: полсотни страниц, отказы по лимиту и падение, после которого отметка стоит
# на месте и прогон повторяется вечно. С потолком остаток догоняется следующими прогонами.
SYNC_LIVE_MAX_WINDOW_MIN=360
SYNC_PAGE_LIMIT=500
# Сколько прогон может законно идти, прежде чем считаться оборванным. Строки `running`
# старше этого воркер закрывает при старте: SIGKILL не даёт прогону закрыть свою строку сам,
# и журнал прогонов начинает копить вечно бегущие строки. Значение — по самому долгому
# законному прогону: догоняющий за неделю идёт около часа.
SYNC_ABANDONED_RUN_MIN=180
# Нижняя граница порога, после которого отставание отметки — уже не задержка, а остановка
# синхронизации. Сам порог считается от интервала прогона (три интервала), но у минутного
# скользящего это три минуты, и жалоба на трёхминутное отставание была бы шумом. Значение
# назначается по суточному замеру живой синхронизации — до замера оно остаётся тем,
# с которым детектор написан.
SYNC_STALE_FLOOR_MIN=15

# Догоняющий прогон: раз в сутки перезапрашивается широкое окно. Заказ, провисевший
# в промежуточном статусе несколько дней, получает время завершения в прошлом, и если
# скользящее окно эту точку уже прошло, увидеть его больше нечем (docs/decisions.md).
SYNC_CATCHUP_ENABLED=false
SYNC_CATCHUP_INTERVAL_SEC=86400
SYNC_CATCHUP_DAYS=7

# --- Telegram (этап 6) ---
TG_BOT_TOKEN=

# --- Входная дверь машины (docker/compose.proxy.yml, только на сервере) ---
APP_DOMAIN=
CADDY_ACME_EMAIL=
# На обкатке — https://acme-staging-v02.api.letsencrypt.org/directory
CADDY_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
