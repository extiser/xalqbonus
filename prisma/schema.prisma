// previewFeatures = ["multiSchema"] не указан намеренно, вопреки чеклисту issue #1:
// в Prisma 7 флаг помечен deprecated и на каждой команде печатает предупреждение.
// Многосхемность работает и без него — граница задана `schemas` в datasource ниже.
generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

// Строка подключения живёт в prisma.config.ts: Prisma 7 в схеме её больше не принимает.
datasource db {
  provider = "postgresql"
  // Prisma владеет только `xb`. `public` сюда не попадает никогда: Prisma управляет всеми
  // перечисленными схемами, и таблица, которой нет в моделях, уходит в diff как удаляемая —
  // первая же миграция ядра сгенерировала бы DROP на все таблицы старого бота.
  schemas  = ["xb"]
}

// Перечисления заводятся только на наши словари — те, что меняются нашей же миграцией.
// Значения, приходящие из Fleet API (статус работы, статус заказа, категория, способ
// оплаты), хранятся как text: чужой словарь нам не принадлежит, и новое значение
// на той стороне не должно ронять синхронизацию (docs/decisions.md).

enum AccountType {
  driver
  emission
  redemption
  raffle_bank

  @@map("account_type")
  @@schema("xb")
}

/// Причины из таблицы ключей идемпотентности в docs/points.md.
/// Новая причина заводится сначала там, потом здесь.
enum PointReason {
  opening
  trip
  welcome
  order_spend
  order_refund
  manual
  recon
  expire
  merge
  raffle
  /// Массовое начисление по кампании и приз сундука акции (issue #181).
  campaign
  /// Баллы новому демо-водителю (issue #212): `demo_grant:<persons.id>`. Своей причиной, а не
  /// `opening`, — чтобы итоги переноса не считали выдуманные баллы перенесёнными.
  demo_grant
  /// Баллы за пройденный опрос (issue #322): `survey:<surveys.id>:<persons.id>`. Своей причиной,
  /// а не `campaign`: опрос платит за действие самого водителя, и «сколько заплатили за опросы»
  /// считается без разбора ключей (docs/points.md → «Баллы за опрос»).
  survey

  @@map("point_reason")
  @@schema("xb")
}

enum LinkCloseReason {
  rebind
  merge
  operator
  invalid_chat
  /// Демо-зрителя выключили (issue #205): его Telegram снова ничей, демо-водитель остаётся.
  demo

  @@map("link_close_reason")
  @@schema("xb")
}

enum LinkConfirmedBy {
  phone_auto
  operator
  driver_reply
  /// Привязка перенесена из старой базы. Ни автоматикой по телефону, ни оператором
  /// она не подтверждалась: `operator` на этих 4 091 строке был бы неправдой, по которой
  /// через год не отличить настоящую проверку в офисе от наследства.
  legacy_import
  /// Привязка демо-зрителя к его демо-водителю (issue #205). Номер никто не проверял: его нет
  /// ни у зрителя, ни у выдуманного водителя, — Telegram внесён в список `make`-целью.
  demo

  @@map("link_confirmed_by")
  @@schema("xb")
}

/// Под какой ролью демо-зритель смотрит приложение (issue #205). Живёт в базе, а не в запросе:
/// роль, присланную клиентом, выставил бы себе кто угодно (docs/principles.md → «Доверие
/// к входным данным»).
enum DemoRole {
  driver
  manager

  @@map("demo_role")
  @@schema("xb")
}

enum Language {
  ru
  uz

  @@map("language")
  @@schema("xb")
}

/// Роль сотрудника парка. Ролей четыре, и они упорядочены: приглашать можно роль строго ниже
/// своей (docs/decisions.md → «Учётка сотрудника и роли»).
///
/// Из четырёх ролей старого бота `coupon_manager` слит с `manager`: погашение купона
/// и выдача заказа — одно и то же действие сотрудника, стоящего в офисе с телефоном,
/// и разводить их отдельной ролью незачем. `senior_manager` — между менеджером и админом:
/// каталог, остатки, офисы и ручная правка баллов (docs/decisions.md → «Старший менеджер;
/// правка баллов и выдача наград руками — не менеджеру»).
enum EmployeeRole {
  owner
  admin
  senior_manager
  manager

  @@map("employee_role")
  @@schema("xb")
}

/// Что открывает одноразовая ссылка к существующей учётке сотрудника (issue #267).
enum EmployeeAccessLinkKind {
  /// Задать пароль — выпускается сбросом пароля.
  password
  /// Привязать Telegram — выпускает руководитель из «Сотрудников» или сотрудник себе.
  telegram

  @@map("employee_access_link_kind")
  @@schema("xb")
}

/// Чем кончилась попытка водителя привязать Telegram в боте.
///
/// Словарь наш и меняется нашей же миграцией — как остальные словари `xb`. Успешные
/// попытки записываются наравне с отказами: без них не считается ни доля автопривязок,
/// ни сколько людей дошло до бота и отвалилось.
enum LinkAttemptOutcome {
  /// Привязали: ровно один активный профиль, не уволен, свободный человек и свободный чат.
  linked
  /// Контакт принадлежит не отправителю — прислан через скрепку из адресной книги.
  contact_not_own
  /// Номера нет в реестре, и точечный прогон его туда не завёл: либо профиль пришёл
  /// без номера удостоверения и лёг в `sync_skips`, либо номер не приводится
  /// к каноническому виду и искать по нему в реестре нечего.
  not_in_registry
  /// Ни в реестре, ни в ответе Fleet API номера нет.
  not_in_park
  /// Профиль нашёлся один, но водитель уволен: номер уволенного мог быть сдан и выдан
  /// другому человеку (docs/drivers.md → «Привязка Telegram: автоматически или в офис»).
  profile_fired
  /// Один номер на нескольких работающих профилях — кто из них пришёл, решает оператор.
  several_profiles
  /// У человека уже есть активная привязка к другому Telegram. Перепривязки не бывает
  /// ни при каких совпадениях: это операция оператора.
  person_already_linked
  /// Этот `chat_id` уже привязан к другому человеку.
  telegram_already_linked
  /// Пара «человек + чат» лежит в истории закрытой строкой: её закрыл оператор или склейка
  /// двойников. Активной привязки при этом нет ни у кого, и вернуть закрытый канал связи
  /// может только оператор — но это не занятый чужой Telegram, и в разборе эти строки
  /// путать нельзя.
  link_closed_in_history
  /// Этот Telegram или этот телефон принадлежит сотруднику парка. Водителем и сотрудником
  /// одновременно быть нельзя, и вторая роль не выдаётся молча: сотрудник получает отказ
  /// со своим текстом (docs/decisions.md → «Доступ определяется ролью, а не дверью»).
  employee_account
  /// Fleet API не ответил после всех попыток. Отдельный исход намеренно: отказ внешнего
  /// сервиса — не решение о водителе, и в офис человека по нему не отправляют.
  ///
  /// Значение держится ровно тем, чем названо: парк спросили, парк не ответил. Всё, что
  /// упало у нас и до парка не дошло, пишется `internal_failure`.
  park_api_unavailable
  /// Проверить номер не вышло на нашей стороне: незаполненное окружение, отказ базы,
  /// любая наша поломка до похода в парк.
  ///
  /// Одно значение на все способы падения намеренно: разбору нужно «их сторона или наша»,
  /// а чем именно упало — видно в логе. Водителю разница не показывается, текст у обоих
  /// исходов один (issue #95).
  internal_failure

  @@map("link_attempt_outcome")
  @@schema("xb")
}

enum SyncKind {
  /// Инкрементальная синхронизация профилей парка: окно по `updated_at`, по расписанию.
  registry
  /// Полный обход реестра нарезкой: запускается командой — первое наполнение, подозрение
  /// на расхождение, аудит. Своей отметки не имеет: двигает отметку `registry`.
  registry_full
  /// Точечный прогон по одному телефону: его заводит бот, когда номер водителя не нашёлся
  /// в реестре. Отметку синхронизации не двигает вовсе — он видел один профиль, а не окно,
  /// и сдвиг отметки после него потерял бы всех, кто изменился за то же время.
  registry_profile
  orders
  orders_catchup
  /// Живой сбор транзакций парка: окно по `event_at` от своей отметки (issue #358).
  transactions
  /// Ночное перечитывание последних суток транзакций целиком. Отметки не имеет: сутки
  /// проходятся заново с первой страницы, а журнал суток истории не трогается.
  transactions_recheck

  @@map("sync_kind")
  @@schema("xb")
}

enum SyncStatus {
  running
  succeeded
  failed

  @@map("sync_status")
  @@schema("xb")
}

/// Почему прогон не записал то, что увидел. Словарь наш и меняется нашей же миграцией —
/// в отличие от статусов и категорий Fleet API, которые лежат текстом.
enum SyncSkipReason {
  /// Заказ водителя, которого нет в `xb.park_profiles`.
  unknown_profile
  /// Заказу не хватило обязательного поля — разобрать его нечем.
  malformed
  /// Значение чужого словаря, которого мы раньше не видели. Записано текстом,
  /// ничего не сломало.
  unknown_value
  /// Профилю пришёл номер удостоверения, уже активный у другого человека. Журнал
  /// удостоверений не тронут: свести двух людей в одного — это перенос баллов,
  /// и синхронизация его не делает (docs/drivers.md → «Склейка двойников»).
  license_conflict

  @@map("sync_skip_reason")
  @@schema("xb")
}

/// Чем запись старой базы сопоставлена с профилем парка.
enum MatchMethod {
  profile_id
  license
  none

  @@map("match_method")
  @@schema("xb")
}

/// Почему остаток офиса изменился. Словарь наш, и каждый вид жёстко связан со знаками
/// движения — соответствие проверяется `stock_movements_kind_signs_check` в миграции,
/// чтобы неверная запись не прошла вовсе.
enum StockMovementKind {
  /// Приход в офис. Центрального склада нет: товар оформляется сразу в офис
  /// (docs/decisions.md → «Каталог: заказ — это касса, остаток живёт по офисам»).
  incoming
  /// Правка остатка руками — пересчёт, бой, недостача. Автор и заметка обязательны:
  /// правка без объяснения через месяц неотличима от ошибки кода.
  adjustment
  /// Оформление заказа: товар ушёл из свободного остатка в резерв.
  order_reserve
  /// Выдача заказа: резерв снят, товар ушёл из офиса.
  order_issue
  /// Отмена заказа: резерв снят, товар вернулся в свободный остаток.
  order_release
  /// Рождение награды-товара: товар ушёл из свободного остатка в резерв под награду.
  /// Свой вид, а не `order_reserve`: три вида заказа обязаны нести заказ, а у награды его нет.
  reward_reserve
  /// Выдача награды на стойке: резерв снят, товар ушёл из офиса.
  reward_issue
  /// Сгорание награды: резерв вернулся в свободный остаток.
  reward_release

  @@map("stock_movement_kind")
  @@schema("xb")
}

/// Состояние заказа за баллы. Висящий — `pending`, и только он занимает резерв и код.
enum OrderStatus {
  pending
  issued
  cancelled

  @@map("order_status")
  @@schema("xb")
}

/// Чем оплачен заказ. Способы не смешиваются: доплатить деньгами к баллам и поделить заказ
/// нельзя (docs/decisions.md → «Заказ оформляет сотрудник у стойки: за баллы или за розницу»).
enum OrderPayment {
  /// Баллами по цене в баллах — переводом со счёта водителя в `redemption`.
  points
  /// В сумах по розничной цене. Деньги система не принимает, а записывает: касса вне её.
  retail

  @@map("order_payment")
  @@schema("xb")
}

/// Откуда заказ: без этого признака отчёты не различат, сколько программа продаёт сама,
/// а сколько проходит через стойку.
enum OrderChannel {
  /// Водитель оформил в боте: код, резерв на сутки, выдача по коду.
  bot
  /// Сотрудник оформил у стойки за водителя: выдан той же операцией, кода и срока нет.
  desk

  @@map("order_channel")
  @@schema("xb")
}

/// Кто отменил заказ. Отмена водителем и сотрудником — один сервис с разной причиной,
/// просрочку ставит воркер.
enum OrderCancelReason {
  driver
  employee
  expired

  @@map("order_cancel_reason")
  @@schema("xb")
}

/// Что за награда. Набор фиксированный: баллы и товары уже есть сущностями, а всё остальное
/// описывается словами (issue #172).
enum RewardKind {
  /// Баллы: зачисляются на баланс сразу, кода и офиса нет.
  points
  /// Товар из `products`: занимает остаток офиса резервом до выдачи.
  product
  /// Произвольная награда, описанная названием. На складе её нет, остаток не трогается.
  custom

  @@map("reward_kind")
  @@schema("xb")
}

/// Где награда. Путь один и в одну сторону: `awaiting` → `issued` или `expired`;
/// `claimable` → `credited` у подарка; у прочих баллов `credited` — конечное с рождения.
enum RewardStatus {
  /// Баллы зачислены на баланс.
  credited
  /// Подарок-баллы ждут, пока водитель заберёт: на балансе их ещё нет. Незабранное
  /// зачисляется само в назначенную дату (issue #219).
  claimable
  /// Ждёт в офисе, код действует.
  awaiting
  /// Получена на стойке.
  issued
  /// Не забрали за срок — сгорела.
  expired

  @@map("reward_status")
  @@schema("xb")
}

/// Почему награда выдаётся — то, что сотрудник видит на карточке у стойки.
enum RewardSource {
  campaign
  manual
  /// Подарок от Xalq Taxi из раздела «Награды» — раздача `gift_grants` (issue #219).
  gift

  @@map("reward_source")
  @@schema("xb")
}

/// Как подарок лёг на баланс: водитель забрал сам или зачислилось по сроку (issue #219).
enum GiftClaimMode {
  driver
  auto

  @@map("gift_claim_mode")
  @@schema("xb")
}

/// Что стало при переносе с `chat_id` записи старой базы.
enum LegacyTelegramStatus {
  linked
  invalid_chat
  pending_confirmation
  skipped

  @@map("legacy_telegram_status")
  @@schema("xb")
}

/// Состояние рассылки. Путь один и в одну сторону: черновик → идёт → остановлена или
/// завершена. Остановленная не возобновляется — она копируется в новый черновик.
enum MailingStatus {
  draft
  running
  stopped
  finished

  @@map("mailing_status")
  @@schema("xb")
}

/// Чем задан сегмент (issue #356).
enum SegmentKind {
  /// Условиями: состав считается запросом в момент обращения.
  conditions
  /// Списком людей (`segment_members`): состав зафиксирован при заведении и не пересчитывается.
  list

  @@map("segment_kind")
  @@schema("xb")
}

/// Чем кончилась рассылка для одного адресата.
enum MailingRecipientOutcome {
  /// Ещё не отправлено: очередь не дошла или рассылку остановили раньше.
  pending
  sent
  /// Человек выключил уведомления — рассылка уважает это так же, как начисление.
  skipped_disabled
  /// Писать некуда: Telegram сказал, что канал умер, или активной привязки к моменту
  /// отправки не осталось. Привязка при этом не закрывается — только исход.
  invalid_chat
  /// Telegram отклонил запрос или отказы сети не кончились за все попытки.
  failed

  @@map("mailing_recipient_outcome")
  @@schema("xb")
}

/// Тип вопроса опроса (issue #320).
enum SurveyQuestionType {
  /// Один ответ из вариантов.
  single
  /// Несколько ответов из вариантов.
  multiple
  /// Свободный текст. Вариантов нет.
  text
  /// Шкала 1–5. Значения фиксированы и вариантами не заводятся.
  scale

  @@map("survey_question_type")
  @@schema("xb")
}

/// Состояние акции. Путь один и в одну сторону: черновик → идёт → окончена. Запущенная
/// не правится и не отменяется: окно кончается само (issue #166).
enum CampaignStatus {
  draft
  running
  finished

  @@map("campaign_status")
  @@schema("xb")
}

/// Половина состава акции. Без деления у всех `a`, а был ли контроль, отвечает
/// `campaigns.split_enabled`, а не пустая колонка.
enum CampaignHalfCode {
  a
  b

  @@map("campaign_half")
  @@schema("xb")
}

/// Где водитель в акции — только то, что он меняет сам. Исходы окна («вернулся»,
/// «не дотянул»…) сюда не входят: их ставит итог окна, а он считается от зачётного дня.
///
/// Назад состояния не ходят: `joined` и `declined` — конечные.
enum CampaignParticipantState {
  /// Попал в снимок. Начальное у всех.
  invited
  /// Открыл экран акции в Mini App.
  opened
  /// Нажал «Участвовать».
  joined
  /// Нажал «Отказаться». Своим состоянием, хотя в итоге окна сольётся с «посмотрел
  /// и не вступил»: пока открыт вопрос «позже всё же вступил», явный отказ нужно видеть.
  declined

  @@map("campaign_participant_state")
  @@schema("xb")
}

/// Исход окна участника — чем участие кончилось (issue #168). Ставит итог окна через четыре
/// часа после его конца, один раз, и задним числом не пересматривается. Своим перечислением
/// рядом с состоянием, а не его продолжением: состояние меняет водитель, исход — итог окна.
enum CampaignParticipantOutcome {
  /// Вступил и набрал нужное число зачётных дней.
  returned
  /// Вступил, ездил, зачётных дней не хватило.
  short
  /// Вступил и не сделал после вступления ни одной поездки за окно.
  joined_no_trips
  /// Открыл экран и не вступил. Сюда же явный отказ.
  seen_not_joined
  /// Экран акции не открыл.
  no_response

  @@map("campaign_participant_outcome")
  @@schema("xb")
}

/// Сундук акции — ступень, за которую водитель получает приз (issue #180). Называется
/// по сундуку, а не по призу: открытие сундука заводит свою таблицу на то же перечисление.
enum CampaignChestKind {
  /// Сундук дня: розыгрыш по весам, редкость есть только у него.
  day
  /// Сундук трёх дней: приз фиксированный, розыгрыша нет.
  three_days
  /// Сундук недели: приз фиксированный, розыгрыша нет.
  week

  @@map("campaign_chest_kind")
  @@schema("xb")
}

/// Чем открыт сундук акции (issue #181). `timer` заводится сразу, хотя пишет его следующая
/// задача: колонка со вторым значением задним числом у уже открытых сундуков не появится.
enum CampaignChestOpenSource {
  /// Водитель нажал на заработанный сундук.
  driver
  /// Неоткрытый вскрыт сам в 21:00 дня, которым кончилось окно.
  timer

  @@map("campaign_chest_open_source")
  @@schema("xb")
}

/// Откуда открыт Mini App — по `Telegram.WebApp.platform` (issue #223). Сырое значение
/// Telegram не хранится: его словарь шире (`tdesktop`, `macos`, `weba`, `webk`…), а вопрос
/// к логу один — телефон это или нет.
enum ClientPlatform {
  android
  ios
  /// `tdesktop` и `macos`.
  desktop
  /// Всё прочее, включая веб-версии Telegram и пустое значение.
  other

  @@map("client_platform")
  @@schema("xb")
}

/// Носитель промо-метки (issue #380): где человек увидел ссылку или QR. Подписи —
/// `shared/promo.ts`. После заведения метки не меняется — часть её смысла.
enum PromoMedium {
  poster
  card
  leaflet
  video
  sms
  other

  @@map("promo_medium")
  @@schema("xb")
}

// ---------------------------------------------------------------------------
// Люди и учётки
// ---------------------------------------------------------------------------

/// Человек. Собственных данных у него нет намеренно: имя живёт в профиле парка,
/// номер удостоверения — в журнале удостоверений одной активной строкой.
/// Дубля номера в записи человека нет: два места, обязанные совпадать, однажды
/// не совпадут (docs/decisions.md → «Номер удостоверения хранится в одном месте»).
model Person {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Демо-водитель (issue #205): выдуманный человек, которого видит демо-зритель. Живым
  /// не бывает никогда и источником следующего демо-водителя не служит.
  isDemo    Boolean  @default(false) @map("is_demo")
  /// Демо-водитель спрятан (issue #252): не виден в разделе «Демо», в отборе сегментов
  /// и в поиске водителей. Журнал, поездки и заказы остаются. У живого пусто всегда —
  /// проверкой в миграции.
  demoHiddenAt DateTime? @map("demo_hidden_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  licenses      PersonLicense[]
  parkProfiles  ParkProfile[]
  telegramLinks TelegramLink[]
  settings      PersonSettings?
  // Список, а не одиночная связь: «один водительский счёт на человека» держится
  // частичным уникальным индексом, а частичный индекс Prisma выразить не умеет.
  accounts      Account[]
  legacyRecords LegacyDriverMap[]
  orders        Order[]
  mailings      MailingRecipient[]
  campaigns     CampaignParticipant[]
  rewards       Reward[]
  giftGrants    GiftGrant[]
  demoViewer    DemoViewer?
  surveys       SurveyResponse[]
  segmentMemberships SegmentMember[]
  metricDays    MetricPersonDay[]
  metricPrior   MetricPersonPrior?
  metricMonths  MetricPersonMonth[]
  promoTouches  PromoTouch[]

  @@map("persons")
  @@schema("xb")
}

/// Журнал водительских удостоверений. Активная строка — та, у которой `closed_at` пуст.
model PersonLicense {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId        String    @map("person_id") @db.Uuid
  /// Ровно как пришло из API, без единой правки.
  numberRaw       String    @map("number_raw")
  /// Наша нормализация: server/utils/licenseNumber.ts. `normalized_number` из API
  /// не используется — он побайтово равен `number` у всех 25 390 профилей.
  numberCanonical String    @map("number_canonical")
  country         String?
  issueDate       DateTime? @map("issue_date") @db.Date
  expirationDate  DateTime? @map("expiration_date") @db.Date
  observedAt      DateTime  @default(now()) @map("observed_at") @db.Timestamptz(6)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)
  /// `fleet_api`, `legacy_import`, `operator`.
  source          String

  person Person @relation(fields: [personId], references: [id])

  // Частичные уникальные индексы — активное ВУ на человека и активный номер на одного
  // человека — заведены сырым SQL в миграции: Prisma условие WHERE в индексе не выражает.
  @@index([personId])
  /// Поиск по истории, включая закрытые строки.
  @@index([numberCanonical])
  @@map("person_licenses")
  @@schema("xb")
}

/// Учётка в парке. Ключ — идентификатор из Fleet API как есть.
model ParkProfile {
  profileId String @id @map("profile_id")
  personId  String @map("person_id") @db.Uuid
  parkId    String @map("park_id")

  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  middleName String? @map("middle_name")

  workStatus     String  @map("work_status")
  employmentType String  @map("employment_type")
  isSelfemployed Boolean @map("is_selfemployed")
  workRuleId     String  @map("work_rule_id")
  /// Имя условия работы приходит только в заказах, в реестре его нет.
  workRuleName   String? @map("work_rule_name")

  hireDate DateTime? @map("hire_date") @db.Date
  fireDate DateTime? @map("fire_date") @db.Date

  currentStatus          String    @map("current_status")
  currentStatusUpdatedAt DateTime? @map("current_status_updated_at") @db.Timestamptz(6)

  // Снимок машины. Отдельной таблицы машин нет: машина нужна, чтобы найти водителя
  // в офисе, а история позывных приходит из поездок.
  callsign      String?
  carId         String? @map("car_id")
  carNumber     String? @map("car_number")
  carBrandModel String? @map("car_brand_model")

  apiCreatedAt  DateTime @map("api_created_at") @db.Timestamptz(6)
  apiModifiedAt DateTime @map("api_modified_at") @db.Timestamptz(6)
  /// Верхнеуровневый `updated_at` ответа: по нему строится инкрементальная синхронизация.
  apiUpdatedAt  DateTime @map("api_updated_at") @db.Timestamptz(6)
  firstSeenAt   DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSyncedAt  DateTime @map("last_synced_at") @db.Timestamptz(6)

  person        Person               @relation(fields: [personId], references: [id])
  phones        ProfilePhone[]
  statusEvents  ProfileStatusEvent[]
  trips         Trip[]
  legacyRecords LegacyDriverMap[]

  @@index([personId])
  @@index([apiUpdatedAt])
  @@index([workStatus])
  // Уникальности на позывном нет: 86 позывных встречаются более чем на одном профиле.
  @@index([callsign])
  @@index([carNumber])
  @@map("park_profiles")
  @@schema("xb")
}

/// Журнал телефонов профиля. В API телефоны приходят массивом.
model ProfilePhone {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId  String    @map("profile_id")
  phoneRaw   String    @map("phone_raw")
  /// Заполняется только для номеров вида `+998XXXXXXXXX`: 446 номеров реестра формату
  /// не отвечают, у 9.9% профилей телефона нет вовсе. По этому полю идёт автопривязка.
  phoneE164  String?   @map("phone_e164")
  observedAt DateTime  @default(now()) @map("observed_at") @db.Timestamptz(6)
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)

  profile ParkProfile @relation(fields: [profileId], references: [profileId])

  @@index([profileId])
  @@map("profile_phones")
  @@schema("xb")
}

/// Журнал трудоустройства. Даты смены статуса внешний API в списке не отдаёт,
/// поэтому `observed_at` — дата, когда факт стал известен нам (docs/drivers.md).
model ProfileStatusEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId  String   @map("profile_id")
  /// Пусто у первой записи профиля.
  statusFrom String?  @map("status_from")
  statusTo   String   @map("status_to")
  observedAt DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)
  syncRunId  String?  @map("sync_run_id") @db.Uuid

  profile ParkProfile @relation(fields: [profileId], references: [profileId])
  syncRun SyncRun?    @relation(fields: [syncRunId], references: [id])

  @@index([profileId, observedAt])
  @@map("profile_status_events")
  @@schema("xb")
}

/// Журнал привязок Telegram. Строки не удаляются и не правятся на месте:
/// перепривязка — закрытие прежней строки и новая рядом (docs/drivers.md).
model TelegramLink {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId       String  @map("person_id") @db.Uuid
  telegramChatId BigInt  @map("telegram_chat_id")
  telegramUserId BigInt? @map("telegram_user_id")

  linkedAt           DateTime         @default(now()) @map("linked_at") @db.Timestamptz(6)
  closedAt           DateTime?        @map("closed_at") @db.Timestamptz(6)
  closeReason        LinkCloseReason? @map("close_reason")
  confirmedBy        LinkConfirmedBy  @map("confirmed_by")
  /// Кто из сотрудников подтвердил, если подтверждал человек. Ссылка, а не строка:
  /// в разборе «кто перепривязал аккаунт» через полгода нужна учётка, а не текст.
  operatorEmployeeId String?          @map("operator_employee_id") @db.Uuid
  /// Кто из сотрудников закрыл строку. Пусто у закрытых автоматикой, склейкой, отказом Telegram
  /// и у закрытых до #305.
  closedByEmployeeId String?          @map("closed_by_employee_id") @db.Uuid

  person           Person    @relation(fields: [personId], references: [id])
  // Две связи с `Employee` — обе именованы: без имени Prisma не различит, какая чья.
  operatorEmployee Employee? @relation("TelegramLinkOperator", fields: [operatorEmployeeId], references: [id])
  closedByEmployee Employee? @relation("TelegramLinkClosedBy", fields: [closedByEmployeeId], references: [id])

  // Одна активная привязка на человека и один активный Telegram — частичными
  // уникальными индексами в миграции.
  @@index([personId])
  /// Поиск по истории, включая закрытые привязки.
  @@index([telegramChatId])
  @@map("telegram_links")
  @@schema("xb")
}

/// Участие в программе. Наличие строки и есть граница «известен парку / в программе»:
/// реестр парка живёт без неё (docs/drivers.md).
model PersonSettings {
  personId             String   @id @map("person_id") @db.Uuid
  language             Language
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  joinedAt             DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  /// Откуда пришло участие: `telegram`, `legacy_import`, `operator`.
  joinedSource         String   @map("joined_source")
  /// Когда водитель нажал «Спасибо» на слайде выданного приветственного бонуса (issue #421).
  /// Пусто — не нажимал, и слайд «Ура! Бонус зачислен!» встречает его первым экраном.
  welcomeBonusSeenAt   DateTime? @map("welcome_bonus_seen_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id])

  @@map("person_settings")
  @@schema("xb")
}

/// Демо-зритель (issue #205): человек, чей Telegram внесён в список, смотрит приложение глазами
/// демо-водителя или демо-менеджера — показ программы клиенту и другим паркам.
///
/// У каждого зрителя свой демо-водитель, и привязан он к Telegram зрителя обычной строкой
/// `telegram_links`: для приложения, бота, уведомлений и рассылок зритель — обычный участник,
/// и отдельных путей «для демо» там нет. Эта таблица нужна ровно для двух вещей: знать, чей
/// демо-водитель чей, и под какой ролью зритель смотрит сейчас.
///
/// Заводится и выключается только `make`-целями; строка не удаляется — повторное внесение
/// возвращает зрителю прежнего демо-водителя с его историей.
model DemoViewer {
  /// Telegram зрителя — `user.id` проверенной `initData`.
  telegramUserId BigInt    @id @map("telegram_user_id")
  /// Кто это — «Xalq Taxi, владелец». Для людей, читающих список; приложение его не показывает.
  label          String
  /// Его демо-водитель. Уникален: демо-водитель одного зрителя другому не достаётся.
  personId       String    @unique @map("person_id") @db.Uuid
  currentRole    DemoRole  @default(driver) @map("current_role")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Зритель выключен: привязка к демо-водителю закрыта. Пусто — действует.
  disabledAt     DateTime? @map("disabled_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id])

  @@map("demo_viewers")
  @@schema("xb")
}

/// Приглашение в демо (issue #252): одноразовая ссылка на бота, живёт сутки. Принявший
/// становится демо-зрителем со своим демо-водителем — личность приходит подписанным `from.id`
/// апдейта, Telegram ID руками не вводится нигде.
model DemoInvite {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Подпись будущего зрителя — уходит в `demo_viewers.label` при принятии.
  label                  String
  /// `sha256` от токена, hex. Бот ищет приглашение по нему.
  tokenHash              String    @unique @map("token_hash")
  /// Сам токен — чтобы ссылку можно было скопировать, пока приглашение живо
  /// (docs/decisions.md → «Ссылка приглашения видна, пока жива; сотрудник принимает приглашение в вебе»).
  /// Стирается принятием и отзывом. Пусто у выпущенных до этой колонки.
  token                  String?
  invitedById            String    @map("invited_by_id") @db.Uuid
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt             DateTime? @map("accepted_at") @db.Timestamptz(6)
  /// Кто принял — `from.id` апдейта `/start`.
  acceptedTelegramUserId BigInt?   @map("accepted_telegram_user_id")
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invitedBy Employee @relation(fields: [invitedById], references: [id])

  @@index([invitedById])
  @@map("demo_invites")
  @@schema("xb")
}

/// Лог устройств Mini App: с чего человек открывал приложение и прошёл ли его браузер
/// проверку движка (issue #223). Строка — на сочетание Telegram-аккаунта и строки браузера:
/// обновился WebView или iOS — строка браузера новая, и рядом со старой записью появляется
/// новая. Так в карточке видно, что водитель обновился.
///
/// Хранится по `telegram_user_id`, а не по человеку: пишется и незарегистрированный,
/// и тот, кто в программе не состоит. Человек находится через привязки — открытые и закрытые.
model ClientDevice {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegramUserId BigInt         @map("telegram_user_id")
  /// Заголовок `User-Agent` запроса целиком — по нему разбирают то, чего не разобрал сервис.
  userAgent      String         @map("user_agent")
  platform       ClientPlatform
  /// «9», «16.3». Пусто — строка браузера не разобралась.
  osVersion      String?        @map("os_version")
  /// Major движка: Chrome/WebView у Android, Safari у iOS.
  engineVersion  Int?           @map("engine_version")
  /// `Telegram.WebApp.version` — версия Bot API, которую поддерживает клиент. Версии самого
  /// приложения Telegram у Mini App нет.
  botApiVersion  String?        @map("bot_api_version")
  /// Итог проверки движка на последнем входе.
  engineOk       Boolean        @map("engine_ok")
  firstSeenAt    DateTime       @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt     DateTime       @map("last_seen_at") @db.Timestamptz(6)
  /// Не меньше единицы — проверкой в миграции.
  visits         Int

  @@unique([telegramUserId, userAgent])
  @@index([telegramUserId])
  @@map("client_devices")
  @@schema("xb")
}

/// Попытки привязать Telegram — все до единой, и удачные тоже.
///
/// Отказ без записи не отличается от «водитель не приходил», а доля автопривязок
/// и доля дошедших до бота решают, работает ли довод «зарегистрируйся» при обзвоне парка.
///
/// Внешних ключей нет намеренно: это журнал того, что мы видели в момент попытки, и он
/// не должен ни на что опираться. `profile_id` попытки может принадлежать профилю,
/// который в реестр так и не завёлся, а строка попытки обязана остаться в любом случае.
model TelegramLinkAttempt {
  /// Журнальная таблица, на которую никто не ссылается, — bigint identity вместо uuid,
  /// как у `point_entries` и `sync_skips`.
  id             BigInt             @id @default(autoincrement())
  telegramChatId BigInt             @map("telegram_chat_id")
  /// Отправитель апдейта. Пуст, если Telegram его не показал.
  telegramUserId BigInt?            @map("telegram_user_id")
  /// Номер ровно как пришёл в контакте, без единой правки.
  ///
  /// Пусто у исхода `contact_not_own`: номер там принадлежит человеку, который нам ничего
  /// не присылал и о программе не знает. Именно `NULL`, а не пустая строка: пустая строка
  /// означала бы «номер был, и он пустой», и запрос «попытки без номера» пришлось бы
  /// писать с оглядкой на оба значения.
  phoneRaw       String?            @map("phone_raw")
  /// Наша нормализация. Пусто, если номер к каноническому виду не приводится или его
  /// не записывали вовсе.
  phoneE164      String?            @map("phone_e164")
  outcome        LinkAttemptOutcome
  /// Профиль, на котором сошлась попытка. Пуст у отказов, где профиля не нашлось.
  profileId      String?            @map("profile_id")
  personId       String?            @map("person_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// «Что было с этим человеком» — самый частый вопрос к этой таблице.
  @@index([telegramChatId])
  /// «Сколько отказов какого вида за период» — второй.
  @@index([outcome, createdAt])
  @@map("telegram_link_attempts")
  @@schema("xb")
}

// ---------------------------------------------------------------------------
// Сотрудники парка
// ---------------------------------------------------------------------------

/// Сотрудник парка. С `persons` не связан ничем и никогда: у сотрудника нет водительского
/// удостоверения, профиля в парке и счёта баллов, а `Person` в нашей модели — это человек,
/// которого мы знаем по номеру ВУ (docs/decisions.md → «Учётка сотрудника и роли»).
///
/// Способов входа два, и оба необязательны: `password_hash` пуст у того, кто в веб
/// не ходит, `telegram_user_id` — пока Telegram не подтверждён. Требование «заполнен
/// хотя бы один» стоит проверкой в миграции: учётка, в которую нельзя войти ниоткуда,
/// заводиться не должна. Телефон в число необязательных не входит — он приходит обоими
/// путями заведения учётки.
///
/// Таблицы сессий нет. `disabled_at` выбрасывает человека на следующем же запросе,
/// а `password_changed_at` позже времени выпуска cookie делает недействительными все
/// выданные cookie разом — это и есть «выйти на всех устройствах».
model Employee {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role              EmployeeRole
  fullName          String       @map("full_name")
  /// Логин для входа в веб — `+` и от 7 до 15 цифр, не только узбекский (`normalizeLoginPhone`,
  /// issue #267). СМС на него не шлём: телефон только логин.
  ///
  /// Обязателен: телефон у сотрудника есть всегда — владелец заводится с ним, приглашённому
  /// его задаёт приглашающий. В базе колонка `NOT NULL` с миграции `#84`, и `String?`
  /// здесь был расхождением модели с базой, а не вторым состоянием учётки (`#120`).
  phoneE164         String       @unique @map("phone_e164")
  /// `argon2id`. Пуст после сброса, пока сотрудник не задал новый по ссылке, и у демо-учётки.
  passwordHash      String?      @map("password_hash")
  /// Время последней смены пароля. Доступ им не решается — только отметкой годности ниже.
  passwordChangedAt DateTime?    @map("password_changed_at") @db.Timestamptz(6)
  /// Отметка годности выданных cookie: выпущенный раньше неё недействителен. Двигают её
  /// оба события, гасящие сессии, — выход из веба и смена пароля, — а проверяется она одна.
  sessionsValidFrom DateTime?    @map("sessions_valid_from") @db.Timestamptz(6)
  /// Вторая дверь — Mini App. Заполняется ссылкой привязки из `from.id` апдейта (issue #267),
  /// руками не вводится нигде: опечатка в числе отдала бы приложение постороннему.
  telegramUserId    BigInt?      @unique @map("telegram_user_id")
  /// Учётка выключена. Проверяется на каждом запросе, поэтому действует немедленно.
  disabledAt        DateTime?    @map("disabled_at") @db.Timestamptz(6)
  /// Демо-сотрудник (issue #205): под ним смотрит демо-зритель в роли менеджера. Своего входа
  /// у него нет — ни пароля, ни Telegram (`employees_demo_no_login_check`). Один на роль —
  /// частичным уникальным индексом в миграции.
  isDemo            Boolean      @default(false) @map("is_demo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invitesIssued   EmployeeInvite[] @relation("invite_invited_by")
  demoInvitesIssued DemoInvite[]
  acceptedInvite  EmployeeInvite?  @relation("invite_employee")
  pointTransfers  PointTransfer[]
  telegramLinks   TelegramLink[]   @relation("TelegramLinkOperator")
  telegramLinksClosed TelegramLink[] @relation("TelegramLinkClosedBy")
  offices         EmployeeOffice[]
  ordersCreated   Order[]          @relation("order_created_by")
  ordersIssued    Order[]          @relation("order_issued_by")
  ordersCancelled Order[]          @relation("order_cancelled_by")
  stockMovements  StockMovement[]
  mailings        Mailing[]
  surveys         Survey[]         @relation("survey_created_by")
  surveysFinished Survey[]         @relation("survey_finished_by")
  segments        Segment[]
  campaigns       Campaign[]
  rewardsIssued   Reward[]         @relation("reward_issued_by")
  rewardsGranted  Reward[]         @relation("reward_granted_by")
  giftGrants      GiftGrant[]
  accessLinks       EmployeeAccessLink[] @relation("access_link_employee")
  accessLinksIssued EmployeeAccessLink[] @relation("access_link_issued_by")
  promoLinks        PromoLink[]
  hireCosts         DashboardHireCost[]

  @@map("employees")
  @@schema("xb")
}

/// Приглашение сотрудника: одноразовая ссылка под выбранную роль.
///
/// Учётка создаётся в момент принятия, а не при выпуске ссылки, — поэтому `employee_id`
/// пуст до принятия: неиспользованное приглашение не оставляет за собой мусорной учётки.
///
/// Принимается в вебе (issue #267): имя и телефон задаёт приглашающий, пароль — принявший.
/// Токен лежит рядом с хешем, пока приглашение живо, — ссылку можно скопировать из списка;
/// принятие и отзыв его стирают. Ищется приглашение по хешу.
///
/// Журнала отказов по приглашениям нет намеренно, в отличие от `telegram_link_attempts`
/// у водителей: попыток там тысячи и по ним считается доля дошедших до бота, а учёток
/// сотрудников десяток, и неудачное принятие — разговор двух людей в офисе.
model EmployeeInvite {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role        EmployeeRole
  /// Имя будущей учётки. Пусто у выпущенных до приёма в вебе — они отозваны миграцией.
  fullName    String?      @map("full_name")
  /// Логин будущей учётки, `normalizeLoginPhone`. Пусто у выпущенных до приёма в вебе.
  phoneE164   String?      @map("phone_e164")
  /// `sha256` от токена, hex.
  tokenHash   String       @unique @map("token_hash")
  /// Сам токен — только у живого приглашения (`employee_invites_token_live_check`).
  token       String?
  invitedById String       @map("invited_by_id") @db.Uuid
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime?    @map("accepted_at") @db.Timestamptz(6)
  /// Учётка, заведённая принятием. Уникален: одно приглашение заводит одну учётку.
  employeeId  String?      @unique @map("employee_id") @db.Uuid
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invitedBy Employee  @relation("invite_invited_by", fields: [invitedById], references: [id])
  employee  Employee? @relation("invite_employee", fields: [employeeId], references: [id])

  @@index([invitedById])
  @@map("employee_invites")
  @@schema("xb")
}

/// Одноразовая ссылка к существующей учётке (issue #267): задать пароль после сброса
/// или привязать Telegram.
///
/// Живая ссылка каждого вида у учётки одна — частичным уникальным индексом в миграции:
/// выпуск новой отзывает прежнюю. Токен лежит рядом с хешем, пока ссылка жива, — чтобы её
/// можно было показать снова; использование и отзыв его стирают.
model EmployeeAccessLink {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String                 @map("employee_id") @db.Uuid
  kind       EmployeeAccessLinkKind
  /// `sha256` от токена, hex. Ищется ссылка по нему.
  tokenHash  String                 @unique @map("token_hash")
  /// Сам токен — только у живой ссылки (`employee_access_links_token_live_check`).
  token      String?
  expiresAt  DateTime               @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime?              @map("used_at") @db.Timestamptz(6)
  revokedAt  DateTime?              @map("revoked_at") @db.Timestamptz(6)
  /// Кто выпустил: сбросивший пароль, руководитель или сам сотрудник — у ссылки привязки Telegram.
  issuedById String                 @map("issued_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation("access_link_employee", fields: [employeeId], references: [id])
  issuedBy Employee @relation("access_link_issued_by", fields: [issuedById], references: [id])

  @@index([employeeId])
  @@index([issuedById])
  @@map("employee_access_links")
  @@schema("xb")
}

// ---------------------------------------------------------------------------
// Баллы
// ---------------------------------------------------------------------------

/// Счёт. Водительский принадлежит человеку, системный — программе.
/// `balance` — кэш, а не значение: он меняется только вместе с записью в журнал,
/// в одной транзакции (docs/points.md).
model Account {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type     AccountType
  personId String?     @map("person_id") @db.Uuid
  balance  BigInt      @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  person Person? @relation(fields: [personId], references: [id])

  entries       PointEntry[]
  transfersFrom PointTransfer[] @relation("transfer_from_account")
  transfersTo   PointTransfer[] @relation("transfer_to_account")

  // Проверка «водительский счёт имеет человека, системный не имеет» и оба уникальных
  // индекса — сырым SQL в миграции. Минус у водительского счёта базой не запрещён: он
  // допустим только долгом из переноса старой базы (операция `opening` со счёта водителя),
  // и держат это сервис журнала и инвариант 4, а не база (issue #276).
  @@map("accounts")
  @@schema("xb")
}

/// Перевод: списание с одного счёта и зачисление на другой. Односторонних операций
/// не бывает — баллы перемещаются, а не появляются и исчезают (docs/points.md).
model PointTransfer {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reason         PointReason
  /// Формат — дословно таблица ключей из docs/points.md. Новых схем ключа не бывает:
  /// нужна — сначала правка документа, потом код.
  idempotencyKey String      @unique @map("idempotency_key")
  amount         BigInt

  fromAccountId String @map("from_account_id") @db.Uuid
  toAccountId   String @map("to_account_id") @db.Uuid

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Контекст операции — явными полями, а не jsonb: колонка с разнородным содержимым
  // не проверяется ни типом, ни запросом.
  tripOrderId     String? @map("trip_order_id")
  /// Заказ товара за баллы — наша собственная сущность, а не заказ такси из Fleet API.
  /// Рядом с `trip_order_id` намеренно: одно слово, разные вещи, и путать их в журнале
  /// нельзя (docs/points.md).
  ///
  /// Внешний ключ отложенный (`DEFERRABLE INITIALLY DEFERRED`): ссылки кольцевые —
  /// заказ помнит свой перевод списания, перевод помнит свой заказ, а ключ
  /// идемпотентности строится от `orders.id`. Внутри одной транзакции сначала пишется
  /// перевод, потом заказ, и проверка ссылки приходится на фиксацию.
  orderId         String? @map("order_id") @db.Uuid
  legacyOrderId   Int?    @map("legacy_order_id")
  /// Путь, которым пришла операция. Заполняется в том числе автоматикой, у которой учётки
  /// нет вовсе (`legacy_import`), — поэтому остаётся строкой и смысла не меняет.
  actor           String?
  /// Человек, когда человек был. Ручное списание, записанное текстом, через полгода
  /// не отвечает на вопрос «кто снял баллы» (docs/decisions.md → «След сотрудника
  /// в журналах — ссылка, а не строка»).
  actorEmployeeId String? @map("actor_employee_id") @db.Uuid
  note            String?

  fromAccount   Account      @relation("transfer_from_account", fields: [fromAccountId], references: [id])
  toAccount     Account      @relation("transfer_to_account", fields: [toAccountId], references: [id])
  actorEmployee Employee?    @relation(fields: [actorEmployeeId], references: [id])
  entries       PointEntry[]
  order         Order?       @relation("transfer_order", fields: [orderId], references: [id])

  // Обратные концы ссылок заказа на свои переводы. Связей между этими двумя таблицами
  // три, и Prisma требует имя каждой: списание, возврат и контекстная колонка выше.
  spentOnOrder  Order? @relation("order_spend_transfer")
  refundedOrder Order? @relation("order_refund_transfer")

  @@index([reason, occurredAt])
  @@map("point_transfers")
  @@schema("xb")
}

/// Записи журнала. На перевод приходится ровно две строки, их сумма ноль —
/// ограничением базы это не выражается, проверяется запросом из scripts/invariants.sql.
model PointEntry {
  /// Журнальная таблица, на которую никто не ссылается, — bigint identity вместо uuid.
  id         BigInt   @id @default(autoincrement())
  transferId String   @map("transfer_id") @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  delta      BigInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transfer PointTransfer @relation(fields: [transferId], references: [id])
  account  Account       @relation(fields: [accountId], references: [id])

  /// Одна строка на счёт в переводе.
  @@unique([transferId, accountId])
  @@index([accountId, id])
  @@map("point_entries")
  @@schema("xb")
}

// ---------------------------------------------------------------------------
// Поездки
// ---------------------------------------------------------------------------

/// Заказ из Fleet API. Наполняется только тем, что пришло из API: 1.19 млн старых
/// поездок не переносятся (docs/decisions.md).
model Trip {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// То самое ограничение, отсутствие которого в старой базе дало 59 812 лишних строк
  /// и 4 877 повторно засчитанных завершённых поездок.
  orderId   String @unique @map("order_id")
  shortId   Int?   @map("short_id")
  /// Человек здесь не хранится и хранить его нельзя: он берётся через профиль,
  /// иначе склейка двойников превращается в переписывание миллиона строк.
  profileId String @map("profile_id")

  status        String
  category      String
  paymentMethod String  @map("payment_method")
  provider      String
  orderTypeId   String? @map("order_type_id")
  orderTypeName String? @map("order_type_name")
  workRuleId    String? @map("work_rule_id")

  bookedAt     DateTime  @map("booked_at") @db.Timestamptz(6)
  apiCreatedAt DateTime  @map("api_created_at") @db.Timestamptz(6)
  drivingAt    DateTime? @map("driving_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)

  price   Decimal  @db.Decimal(12, 2)
  /// Пробег заполнен у 68% заказов.
  mileage Decimal? @db.Decimal(12, 2)

  carId            String  @map("car_id")
  carCallsign      String? @map("car_callsign")
  carLicenseNumber String  @map("car_license_number")
  carBrandModel    String  @map("car_brand_model")

  addressFromText String @map("address_from_text")
  addressFromLat  Float  @map("address_from_lat")
  addressFromLon  Float  @map("address_from_lon")

  cancellationDescription String?  @map("cancellation_description")
  flags                   String[]
  amenities               String[]

  syncRunId String?  @map("sync_run_id") @db.Uuid
  syncedAt  DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  profile     ParkProfile      @relation(fields: [profileId], references: [profileId])
  syncRun     SyncRun?         @relation(fields: [syncRunId], references: [id])
  events      TripEvent[]
  routePoints TripRoutePoint[]

  @@index([profileId, endedAt])
  @@index([endedAt])
  @@index([status])
  @@map("trips")
  @@schema("xb")
}

/// Переходы статуса заказа из `events`.
model TripEvent {
  id          BigInt   @id @default(autoincrement())
  tripId      String   @map("trip_id") @db.Uuid
  orderStatus String   @map("order_status")
  eventAt     DateTime @map("event_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id])

  /// Перекрытие окон опроса не должно плодить копии.
  @@unique([tripId, orderStatus, eventAt])
  @@index([tripId, eventAt])
  @@map("trip_events")
  @@schema("xb")
}

/// Точки маршрута: до четырёх, у 3.8% заказов их нет вовсе.
model TripRoutePoint {
  id      BigInt @id @default(autoincrement())
  tripId  String @map("trip_id") @db.Uuid
  seq     Int
  address String
  lat     Float
  lon     Float

  trip Trip @relation(fields: [tripId], references: [id])

  @@unique([tripId, seq])
  @@map("trip_route_points")
  @@schema("xb")
}

// ---------------------------------------------------------------------------
// Синхронизация
// ---------------------------------------------------------------------------

/// Прогон синхронизации.
model SyncRun {
  id     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind   SyncKind
  status SyncStatus

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  windowFrom DateTime? @map("window_from") @db.Timestamptz(6)
  windowTo   DateTime? @map("window_to") @db.Timestamptz(6)

  requests     Int     @default(0)
  rateLimited  Int     @default(0) @map("rate_limited")
  itemsSeen    Int     @default(0) @map("items_seen")
  itemsWritten Int     @default(0) @map("items_written")
  error        String?

  states          SyncState[]
  trips           Trip[]
  statusEvents    ProfileStatusEvent[]
  orderDetails    SyncRunOrders?
  registryDetails SyncRunRegistry?
  firstSkips      SyncSkip[]           @relation("skip_first_run")
  lastSkips       SyncSkip[]           @relation("skip_last_run")

  @@index([kind, startedAt(sort: Desc)])
  @@map("sync_runs")
  @@schema("xb")
}

/// Строка появляется и у упавшего прогона: у него важнее всего видеть, сколько он успел.
model SyncRunOrders {
  runId String @id @map("run_id") @db.Uuid

  pages          Int @default(0)
  ordersInserted Int @default(0) @map("orders_inserted")
  ordersUpdated  Int @default(0) @map("orders_updated")

  /// Заказы, которым не хватило обязательного поля. Не записаны, потеряны из виду.
  malformed             Int @default(0)
  /// Заказы водителей, которых нет в реестре парка.
  skippedUnknownProfile Int @default(0) @map("skipped_unknown_profile")
  /// Сколько разных водителей стоит за предыдущим счётчиком.
  unknownProfiles       Int @default(0) @map("unknown_profiles")

  // Разбор начисления — теми же именами, что у сводки сервиса баллов.
  awarded        Int @default(0)
  /// Приветственных бонусов выдано: столько новых водителей дошло до пятой поездки.
  /// В `awarded` он не виден — там поездки, а не люди.
  welcomeAwarded Int @default(0) @map("welcome_awarded")
  alreadyAwarded Int @default(0) @map("already_awarded")
  notCompleted   Int @default(0) @map("not_completed")
  withoutEndedAt Int @default(0) @map("without_ended_at")
  outsideProgram Int @default(0) @map("outside_program")
  unknownTrip    Int @default(0) @map("unknown_trip")
  /// Балл за заказ уже дал старый бот, и он лежит в перенесённом балансе (`legacy_awarded_trips`).
  awardedByLegacy Int @default(0) @map("awarded_by_legacy")

  run SyncRun @relation(fields: [runId], references: [id])

  @@map("sync_run_orders")
  @@schema("xb")
}

/// Детали прогона профилей: то, чего у прогона заказов не бывает. Строка появляется
/// и у упавшего прогона — у него важнее всего видеть, сколько он успел.
model SyncRunRegistry {
  runId String @id @map("run_id") @db.Uuid

  /// Страницы выборки. Промеры размеров кусков сюда не входят — они в `sync_runs.requests`.
  pages Int @default(0)

  // Все три счётчика ниже считают РАЗЛИЧНЫЕ профили, а не строки ответа. Иначе колонка
  // означала бы у полного обхода одно, у инкрементального другое, и свод за период
  // складывал бы несравнимое.
  /// Различных профилей, которые показал API. С этим числом сверяется `total` каждого куска.
  profilesSeen     Int @default(0) @map("profiles_seen")
  /// Из них появились в реестре впервые.
  profilesInserted Int @default(0) @map("profiles_inserted")
  /// Из них уже были: прогон подтвердил их, а не добавил.
  profilesUpdated  Int @default(0) @map("profiles_updated")
  /// Строк в ответах API — то есть цена обхода, а не размер парка.
  ///
  /// У полного обхода она заметно выше числа профилей: кусок крупнее 3 000 берётся
  /// с двух концов, половины перекрываются намеренно, и повтор снимается по `id`.
  /// Разница между этим числом и `profiles_seen` и есть плата за нарезку — её полезно
  /// видеть: она растёт вместе с парком и первой скажет, что пора менять раскладку кусков.
  responseRows     Int @default(0) @map("response_rows")

  /// Люди, заведённые под новые профили. Найденные по номеру ВУ сюда не попадают.
  personsCreated        Int @default(0) @map("persons_created")
  /// Смены статуса трудоустройства, записанные этим прогоном.
  statusEvents          Int @default(0) @map("status_events")
  phonesOpened          Int @default(0) @map("phones_opened")
  phonesClosed          Int @default(0) @map("phones_closed")
  /// Удостоверения, у которых закрыта прежняя строка и открыта новая.
  licensesUpdated       Int @default(0) @map("licenses_updated")
  /// Номер пришёл, но активен у другого человека — журнал не тронут, строка в `sync_skips`.
  licenseConflicts      Int @default(0) @map("license_conflicts")
  /// Профили без номера ВУ: не заведены, лежат в `sync_skips` причиной `malformed`.
  skippedWithoutLicense Int @default(0) @map("skipped_without_license")
  /// Профили, которым не хватило обязательного поля.
  malformed             Int @default(0)
  /// Заказы, чей водитель наконец нашёлся: строки `unknown_profile` закрыты.
  resolvedSkips         Int @default(0) @map("resolved_skips")

  /// Нарезка полного обхода. У инкрементального прогона нарезки нет — нули.
  chunksTotal    Int @default(0) @map("chunks_total")
  chunksWindowed Int @default(0) @map("chunks_windowed")
  /// Самый глубокий offset обхода. Рабочий предел 3 500 замерен разведкой: прогон,
  /// подошедший к нему вплотную, — предупреждение, что кусок вырос.
  maxOffsetDepth Int @default(0) @map("max_offset_depth")

  run SyncRun @relation(fields: [runId], references: [id])

  @@map("sync_run_registry")
  @@schema("xb")
}

/// Что прогон не смог записать или разобрать — поимённо и без обрезки.
///
/// Строка одна на пропущенное, а не на прогон: перекрытие окон приносит один и тот же
/// пропущенный заказ каждый прогон, и без уникальности таблица росла бы линейно по времени,
/// а вопрос «сколько потеряно» перестал бы иметь ответ. Повтор двигает `last_seen_at`
/// и увеличивает `times_seen`.
///
/// `resolved_at` отличает «что потеряно до сих пор» от «что когда-либо пропускалось»:
/// он проставляется, когда пропущенное всё-таки записалось.
model SyncSkip {
  id        BigInt         @id @default(autoincrement())
  reason    SyncSkipReason
  /// Идентификатор заказа — у `unknown_profile` и `malformed`; строка `словарь=значение`
  /// целиком — у `unknown_value`: одно значение приходит из разных словарей и схлопнулось
  /// бы уникальностью в одну строку.
  reference String
  /// Чего не хватило: имя поля у `malformed`, идентификатор профиля у `unknown_profile`,
  /// имя словаря у `unknown_value`. Адресов, телефонов и имён здесь не бывает.
  detail    String?

  firstRunId String @map("first_run_id") @db.Uuid
  lastRunId  String @map("last_run_id") @db.Uuid

  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// В скольких прогонах это пропущенное встретилось — по единице за прогон, сколько бы
  /// раз он его ни принёс.
  ///
  /// «Подряд» здесь не читается: скользящий и догоняющий прогоны идут по пересекающимся
  /// окнам, и один и тот же заказ приходит в обоих. Счётчик их складывает и порядка
  /// не помнит.
  ///
  /// У строки со ссылкой `(без id)`, куда сходятся записи, разбор которых споткнулся
  /// раньше идентификатора, он не значит и этого: сколько бы таких записей прогон
  /// ни принёс, строка одна, и она растёт на единицу. Сколько их было — говорит
  /// `sync_run_orders.malformed`, а какие именно — не говорит ничто.
  timesSeen   Int      @default(1) @map("times_seen")

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  firstRun SyncRun @relation("skip_first_run", fields: [firstRunId], references: [id])
  lastRun  SyncRun @relation("skip_last_run", fields: [lastRunId], references: [id])

  /// То самое ограничение, без которого повтор окна плодит копии.
  @@unique([reason, reference])
  /// Разрешение пропущенного ищет строку по одному лишь идентификатору заказа.
  @@index([reference])
  /// Список нерешённого — самый частый запрос отчёта.
  @@index([resolvedAt, timesSeen(sort: Desc)])
  @@map("sync_skips")
  @@schema("xb")
}

/// Отметка синхронизации. Двигается только после успешного прогона — её сдвиг
/// при неуспехе породил в старом боте счётчик дней простоя и скрыл отказы по лимиту.
model SyncState {
  kind      SyncKind  @id
  watermark DateTime? @db.Timestamptz(6)
  /// Границы идущего или последнего прохода догона. Заполнены только у `orders_catchup`,
  /// у него же `watermark` — позиция прохода: конец последнего пройденного куска.
  /// Пусто — прохода не было (issue #286).
  passFrom  DateTime? @map("pass_from") @db.Timestamptz(6)
  passTo    DateTime? @map("pass_to") @db.Timestamptz(6)
  lastRunId String?   @map("last_run_id") @db.Uuid
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lastRun SyncRun? @relation(fields: [lastRunId], references: [id])

  @@map("sync_state")
  @@schema("xb")
}

// ---------------------------------------------------------------------------
// Перенос из public
// ---------------------------------------------------------------------------

/// Соответствие записи старой базы новой сущности. Создаётся этим issue,
/// наполняется следующим: без неё перенос не идемпотентен и разобраться потом не в чем.
model LegacyDriverMap {
  /// `public."Drivers".id` старой базы.
  legacyDriverId           Int                  @id @map("legacy_driver_id")
  profileId                String?              @map("profile_id")
  personId                 String?              @map("person_id") @db.Uuid
  matchMethod              MatchMethod          @map("match_method")
  /// Куда склеена половина двойника.
  mergedIntoLegacyDriverId Int?                 @map("merged_into_legacy_driver_id")
  telegramStatus           LegacyTelegramStatus @map("telegram_status")
  /// Баланс старой базы как есть; семь `NULL` в `points` переносятся как ноль.
  legacyPoints             Int                  @map("legacy_points")
  note                     String?
  importedAt               DateTime             @default(now()) @map("imported_at") @db.Timestamptz(6)

  profile ParkProfile? @relation(fields: [profileId], references: [profileId])
  person  Person?      @relation(fields: [personId], references: [id])

  @@index([personId])
  @@index([profileId])
  @@map("legacy_driver_map")
  @@schema("xb")
}

/// Заказы, за которые балл уже дал старый бот: граница между ним и нашим сборщиком.
///
/// Баланс переносится одной операцией `opening`, и баллы старого бота за поездки уже
/// лежат в нём. Ключ `trip:<order_id>` знает только наш журнал — без этой таблицы первый
/// догоняющий прогон начислил бы неделю поездок второй раз (docs/decisions.md → «Граница
/// со старым ботом — по засчитанным заказам»).
///
/// Внешнего ключа на `trips` нет намеренно: таблица наполняется переносом, когда заказа
/// в `xb.trips` может ещё не быть, — его принесёт сборщик позже.
model LegacyAwardedTrip {
  /// `public."Trips".trip_id` — тот же id заказа Яндекса, что `trips.order_id`. В старой
  /// базе уникального индекса на нём нет, дубли схлопываются здесь первичным ключом.
  orderId        String   @id @map("order_id")
  /// `public."Drivers".id` той строки `Trips`, что взята при схлопывании дублей.
  legacyDriverId Int      @map("legacy_driver_id")
  bookedAt       DateTime @map("booked_at") @db.Timestamptz(6)
  importedAt     DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@map("legacy_awarded_trips")
  @@schema("xb")
}

// ---------------------------------------------------------------------------
// Каталог, офисы и заказ за баллы
// ---------------------------------------------------------------------------

/// Офис парка: место, где водитель получает товар.
///
/// Не удаляется никогда — на него ссылаются заказы, а история выдач обязана помнить,
/// где именно человек забрал товар. Закрытый офис помечается `archived_at`: водителю
/// он не показывается и заказов не принимает.
///
/// `address` — текст для человека, его берут сообщения водителю. `map_url` — ссылка
/// на карту: в старой базе адресом была именно она, и подставить её в сообщение вместо
/// адреса нельзя (docs/decisions.md → «Каталог: заказ — это касса, остаток живёт
/// по офисам»).
model Office {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  address    String
  mapUrl     String?   @map("map_url")
  workHours  String?   @map("work_hours")
  phoneE164  String?   @map("phone_e164")
  telegram   String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  /// ДЕМО ОФИС (issue #205) — офис демо-менеджера. Живому водителю не виден нигде и заказов
  /// от него не принимает (issue #212); демо-водитель видит его рядом с живыми. Править
  /// демо-офис может только владелец.
  isDemo     Boolean   @default(false) @map("is_demo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees EmployeeOffice[]
  stock     OfficeStock[]
  movements StockMovement[]
  orders    Order[]
  rewards   Reward[]
  campaigns Campaign[]

  @@map("offices")
  @@schema("xb")
}

/// За какими офисами закреплён сотрудник. Связь многие-ко-многим, отложенная в `#84`
/// до появления таблицы офисов: связи под несуществующую таблицу не бывает
/// (docs/decisions.md → «Учётка сотрудника и роли»).
///
/// Своего `id` у строки нет: пара и есть её личность, и второй такой пары не существует.
model EmployeeOffice {
  employeeId String   @map("employee_id") @db.Uuid
  officeId   String   @map("office_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id])
  office   Office   @relation(fields: [officeId], references: [id])

  @@id([employeeId, officeId])
  @@index([officeId])
  @@map("employee_offices")
  @@schema("xb")
}

/// Товар каталога.
///
/// Не удаляется, а архивируется: на него ссылаются позиции заказов, и позиция обязана
/// помнить, что именно было заказано.
///
/// Три цены рядом не дублируют друг друга: `price_points` — чем платит водитель,
/// `price_retail` и `price_cost` — сумы, по ним считается стоимость балла для отчёта
/// парку. `price_points` строго положителен, розница и себестоимость неотрицательны —
/// проверками в миграции.
///
/// Имя одно: названия каталога — бренды и «тряпка для кузова», парк пишет их сам,
/// и узбекская колонка впрок не закладывается (docs/decisions.md).
///
/// **Черновик — товар без `published_at`** (issue #148). Он заводится первым набранным
/// символом формы, поэтому название и цены у него необязательны, водителю он не виден нигде,
/// а удаляется физически: на черновик не ссылается ни заказ, ни движение остатка. Полнота
/// опубликованного товара и то, что архивным бывает только опубликованный, держатся
/// проверками в миграции. Архив и черновик — разные вещи: архивный товар был живым.
model Product {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Пусто только у черновика.
  name        String?
  description String?
  /// Относительный путь на именованном томе приложения. Файл кладёт веб — здесь только
  /// колонка (docs/decisions.md → «Фото товара — файл на именованном томе приложения»).
  photoPath   String?   @map("photo_path")
  /// Пусто у черновика и может быть пусто у призового товара (`promo`): приз не продаётся,
  /// и выдуманная цена уехала бы в закупочные отчёты (issue #172).
  pricePoints Int?      @map("price_points")
  /// Розничная цена в сумах.
  priceRetail Int?      @map("price_retail")
  /// Себестоимость в сумах.
  priceCost   Int?      @map("price_cost")
  /// Пусто — черновик.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  /// Участвует в акции: приз. Снимает с публикации требование цены в баллах, остальные
  /// поля обязательны по-прежнему.
  promo       Boolean   @default(false)
  /// Не показывать на витрине водителя. Снимается — товар выходит на витрину без повторного
  /// заведения. Остатки офиса и приход видят его всегда: иначе призы некуда оприходовать.
  hiddenInCatalog Boolean @default(false) @map("hidden_in_catalog")
  /// Демо-товар (issue #212): его видит и заказывает только демо-водитель, призом живой акции
  /// он не бывает. Ставится при заведении и больше не меняется — живое в демо не превращается
  /// и обратно. Править демо-товар может только владелец.
  isDemo      Boolean   @default(false) @map("is_demo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  stock      OfficeStock[]
  movements  StockMovement[]
  orderItems OrderItem[]
  rewards    Reward[]
  campaignPrizes CampaignPrize[]

  @@map("products")
  @@schema("xb")
}

/// Остаток товара в офисе. Это **кэш**, ровно в том же смысле, в каком `accounts.balance`
/// кэш журнала баллов: истина — `stock_movements`, а равенство проверяется запросами
/// из scripts/invariants.sql.
///
/// Прямой `UPDATE` этой таблицы запрещён везде, кроме операций, пишущих движение
/// в той же транзакции, — так же, как прямое изменение баланса.
///
/// Оба поля неотрицательны проверкой в миграции: минус в остатке — это ошибка кода,
/// и база обязана её остановить, а не записать.
model OfficeStock {
  officeId  String   @map("office_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  /// Свободный остаток: то, что лежит в офисе и ещё никем не занято.
  onHand    Int      @default(0) @map("on_hand")
  /// Занято висящими заказами и ждущими наградами-товарами. Равно сумме позиций
  /// `pending`-заказов и числу `awaiting`-наград этого офиса — третий запрос остатков
  /// в scripts/invariants.sql.
  reserved  Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  office  Office  @relation(fields: [officeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([officeId, productId])
  @@index([productId])
  @@map("office_stock")
  @@schema("xb")
}

/// Журнал движения остатков: каждая строка отвечает на вопрос «почему остаток такой».
///
/// Знаки задаются видом движения и проверяются в базе
/// (`stock_movements_kind_signs_check`): `incoming` — плюс к свободному остатку,
/// `adjustment` — правка в любую сторону с автором и заметкой, `order_reserve` —
/// из свободного в резерв, `order_issue` — резерв ушёл из офиса, `order_release` —
/// резерв вернулся в свободный остаток. Три вида заказа обязаны нести заказ, три вида награды
/// (`reward_reserve`, `reward_issue`, `reward_release`) — награду и не несут заказа.
model StockMovement {
  /// Журнальная таблица, на которую никто не ссылается, — bigint identity вместо uuid.
  id            BigInt            @id @default(autoincrement())
  officeId      String            @map("office_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  kind          StockMovementKind
  deltaOnHand   Int               @default(0) @map("delta_on_hand")
  deltaReserved Int               @default(0) @map("delta_reserved")
  /// Заказ, которым вызвано движение. Пуст у прихода и правки, обязателен у трёх
  /// видов заказа.
  orderId       String?           @map("order_id") @db.Uuid
  /// Награда, которой вызвано движение. Обязательна у трёх видов награды, пуста у остальных.
  rewardId      String?           @map("reward_id") @db.Uuid
  /// Сотрудник, оформивший приход, правку или выдачу. Пуст у движения, которое сделал
  /// водитель из Mini App или воркер просрочки.
  employeeId    String?           @map("employee_id") @db.Uuid
  note          String?
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  office   Office    @relation(fields: [officeId], references: [id])
  product  Product   @relation(fields: [productId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])
  reward   Reward?   @relation(fields: [rewardId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([officeId, productId, id])
  @@index([orderId])
  @@index([rewardId])
  @@map("stock_movements")
  @@schema("xb")
}

/// Заказ товара — за баллы или за розницу.
///
/// Заказ — это касса: баллы списываются в момент оформления, а не выдачи, одной
/// транзакцией вместе с резервом остатка. Выдача переводов не делает вовсе, отмена
/// возвращает баллы целиком (docs/decisions.md → «Каталог: заказ — это касса, остаток
/// живёт по офисам»).
///
/// Оформляет его водитель в боте или сотрудник у стойки за водителя. Заказ стойки выдан
/// той же операцией: кода, срока и резерва на сутки у него нет. За розницу — только у стойки,
/// и водителю такой заказ не показывается: это продажа парка, а не операция программы
/// (docs/decisions.md → «Заказ оформляет сотрудник у стойки: за баллы или за розницу»).
///
/// Согласованность статуса с полями держится проверками в миграции: у `issued` заполнены
/// время и сотрудник выдачи, у `cancelled` — время, причина и перевод возврата, автор
/// отмены есть только у причины `employee`. Так же — способа оплаты и канала с полями:
/// сумма в баллах и перевод списания ровно у `points`, сумма в сумах ровно у `retail`,
/// код и срок ровно у `bot`, автор ровно у `desk`.
model Order {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Сквозной номер для людей: «№ 1042» в истории водителя и на стойке. Для ключей
  /// идемпотентности не годится — они строятся от `id`, который рождается при вставке
  /// и живёт с заказом (docs/points.md).
  number   Int    @unique @default(autoincrement())
  personId String @map("person_id") @db.Uuid
  /// Один заказ — один офис: остатки по офисам разные, и водитель выбирает офис
  /// до витрины.
  officeId String @map("office_id") @db.Uuid

  status  OrderStatus
  payment OrderPayment
  channel OrderChannel
  /// Пять цифр, которые водитель называет на стойке. Уникальны среди `pending`
  /// частичным индексом: выданные и отменённые коды освобождаются. Пусто у заказа стойки:
  /// водитель стоит перед сотрудником, называть нечего.
  code    String?

  /// Сумма в баллах на момент оформления. Ровно столько списано и ровно столько
  /// возвращается при отмене. Только у `points`.
  totalPoints Int?      @map("total_points")
  /// Сумма в сумах по розничным ценам на момент оформления. Только у `retail`.
  totalRetail Int?      @map("total_retail")
  /// Когда заказ перестаёт висеть. Автоотмена — сутки (docs/decisions.md). Только у `bot`:
  /// заказ стойки не висит ни минуты.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)

  /// Сотрудник, оформивший заказ у стойки. Пуст у заказа водителя.
  createdByEmployeeId String? @map("created_by_employee_id") @db.Uuid

  issuedAt           DateTime? @map("issued_at") @db.Timestamptz(6)
  issuedByEmployeeId String?   @map("issued_by_employee_id") @db.Uuid

  cancelledAt           DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelReason          OrderCancelReason? @map("cancel_reason")
  /// Сотрудник, отменивший заказ. Пуст у отмены водителем и у просрочки — там человека
  /// не было.
  cancelledByEmployeeId String?            @map("cancelled_by_employee_id") @db.Uuid

  /// Перевод списания. Заполнен ровно у `points`: у розничного заказа баллы не трогаются.
  spendTransferId  String? @unique @map("spend_transfer_id") @db.Uuid
  /// Перевод возврата. Появляется вместе со статусом `cancelled`.
  refundTransferId String? @unique @map("refund_transfer_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  person              Person         @relation(fields: [personId], references: [id])
  office              Office         @relation(fields: [officeId], references: [id])
  createdByEmployee   Employee?      @relation("order_created_by", fields: [createdByEmployeeId], references: [id])
  issuedByEmployee    Employee?      @relation("order_issued_by", fields: [issuedByEmployeeId], references: [id])
  cancelledByEmployee Employee?      @relation("order_cancelled_by", fields: [cancelledByEmployeeId], references: [id])
  spendTransfer       PointTransfer? @relation("order_spend_transfer", fields: [spendTransferId], references: [id], onDelete: Restrict)
  refundTransfer      PointTransfer? @relation("order_refund_transfer", fields: [refundTransferId], references: [id])

  items     OrderItem[]
  movements StockMovement[]
  /// Переводы, помнящие этот заказ контекстной колонкой. Те же списание и возврат,
  /// с другой стороны ссылки.
  transfers PointTransfer[] @relation("transfer_order")

  @@index([personId, createdAt])
  @@index([officeId, status])
  @@map("orders")
  @@schema("xb")
}

/// Позиция заказа. Помнит цену на момент оформления: цена товара меняется, а заказ
/// обязан помнить, за сколько был оформлен (docs/decisions.md).
///
/// Цена одна из двух — в баллах или в сумах, проверкой в миграции. Какая именно, решает способ
/// оплаты заказа, а это другая таблица, и проверкой строки его не достать: согласие держит
/// единственный путь вставки — сервисы оформления — и тесты ядра.
model OrderItem {
  /// Журнальная таблица, на которую никто не ссылается, — bigint identity вместо uuid.
  id         BigInt @id @default(autoincrement())
  orderId    String @map("order_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  quantity   Int
  /// Цена в баллах. Только у позиции заказа `points`.
  unitPoints Int?   @map("unit_points")
  /// Розничная цена в сумах. Только у позиции заказа `retail`.
  unitRetail Int?   @map("unit_retail")
  /// Себестоимость единицы в сумах на момент заказа, дальше живёт своей жизнью от цены
  /// каталога (issue #372). Пусто — у товара в момент заказа себестоимость не была задана.
  /// Строки до снимка заполнены ценой каталога на день, когда снимок заведён.
  unitCost   Int?   @map("unit_cost")

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  /// Один товар — одна строка в заказе: две строки на один товар означали бы два
  /// разных количества одного и того же.
  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
  @@schema("xb")
}

// ---------------------------------------------------------------------------
// Рассылки
// ---------------------------------------------------------------------------

/// Рассылка участникам программы в Telegram.
///
/// Согласованность статуса с отметками времени держится проверкой в миграции: у черновика
/// нет ни запуска, ни конца, у идущей есть запуск и нет конца, у остановленной
/// и завершённой есть оба.
///
/// Черновик заводится первым набранным символом формы (issue #148), поэтому заголовок
/// и тексты у него необязательны. Без заголовка и текста хотя бы на одном языке рассылка
/// не запускается: у всего, что не черновик, они есть — проверкой в миграции.
model Mailing {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Служебный заголовок — для списка на экране. Водителю не уходит. Пусто только у черновика.
  title            String?
  /// Пусто — уходит один узбекский текст, без заголовков языков. Обязателен хотя бы один
  /// из двух: сообщение уходит всем участникам, какой бы язык ни был у них в профиле.
  textRu           String?       @map("text_ru")
  /// Пусто — уходит один русский текст, без заголовков языков.
  textUz           String?       @map("text_uz")
  /// Относительный путь на томе приложения. Файл кладёт веб — здесь только колонка.
  photoPath        String?       @map("photo_path")
  status           MailingStatus
  createdById      String        @map("created_by_id") @db.Uuid
  startedAt        DateTime?     @map("started_at") @db.Timestamptz(6)
  /// Когда рассылка кончилась — остановкой или тем, что адресаты кончились.
  finishedAt       DateTime?     @map("finished_at") @db.Timestamptz(6)
  /// Когда запустили отзыв отправленного. Заполнено — отзыв второй раз не запускается.
  /// Бывает только у остановленной и завершённой — проверкой в миграции.
  recallStartedAt  DateTime?     @map("recall_started_at") @db.Timestamptz(6)
  /// Когда очередь прошла всех адресатов отзыва. С него «отозвано N из M» — итог, а не ход.
  recallFinishedAt DateTime?     @map("recall_finished_at") @db.Timestamptz(6)
  /// Демо-рассылка (issue #212): уходит только демо-водителям. Живая уходит всем участникам,
  /// демо-водителям тоже — живое до демо доходит. Ставится при заведении и не меняется; копия
  /// наследует. Править демо-рассылку может только владелец.
  isDemo           Boolean       @default(false) @map("is_demo")
  /// Сегмент адресатов (issue #321). Пусто — все участники программы с привязкой Telegram.
  /// Сегмент отбирает, но не расширяет: адресаты — пересечение его состава с этой аудиторией.
  /// Правится только у черновика.
  segmentId        String?       @map("segment_id") @db.Uuid
  /// Прикреплённый опрос (issue #321): сообщение уходит с кнопкой «Пройти опрос». Запуск
  /// замораживает опрос. Один опрос — у нескольких рассылок. Правится только у черновика.
  surveyId         String?       @map("survey_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy  Employee           @relation(fields: [createdById], references: [id])
  /// `Restrict`, как у акции: сегмент не удаляется (архив), а удалённый не должен молча
  /// стирать ответ «кому ушло».
  segment    Segment?           @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  /// `Restrict`: черновик опроса, прикреплённый к рассылке, не удаляется — отказ словами
  /// (`deleteDraftSurvey`), а не молчаливое открепление чужого черновика.
  survey     Survey?            @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  recipients MailingRecipient[]

  @@index([createdAt(sort: Desc)])
  @@map("mailings")
  @@schema("xb")
}

/// Снимок адресатов на момент запуска.
///
/// Пара «рассылка + человек» — первичный ключ, и это защита от двойной отправки: повтор
/// снимка второй строки не заводит, а отправка пишет исход условием «ещё `pending`».
/// Водитель, вступивший в программу во время рассылки, в снимок не попадает.
model MailingRecipient {
  mailingId String                  @map("mailing_id") @db.Uuid
  personId  String                  @map("person_id") @db.Uuid
  outcome   MailingRecipientOutcome
  /// Когда исход стал известен. Пусто у `pending`.
  outcomeAt DateTime?               @map("outcome_at") @db.Timestamptz(6)
  /// Идентификатор сообщения у получателя, вернувшийся от Telegram. Есть ровно у `sent`:
  /// удалить отправленное можно только по нему, и не записанный при отправке он теряется
  /// навсегда.
  messageId BigInt?                 @map("message_id")
  /// Когда сообщение удалено у получателя отзывом. Исход при этом прежний — `sent`: отзыв
  /// не отменяет факта, что сообщение дошло. Пусто у не отозванного, причина не хранится.
  recalledAt DateTime?              @map("recalled_at") @db.Timestamptz(6)

  mailing Mailing @relation(fields: [mailingId], references: [id])
  person  Person  @relation(fields: [personId], references: [id])

  @@id([mailingId, personId])
  /// Счётчики исходов по рассылке и выборка ещё не отправленных.
  @@index([mailingId, outcome])
  @@index([personId])
  @@map("mailing_recipients")
  @@schema("xb")
}

// ---------------------------------------------------------------------------
// Опросы

/// Опрос водителей (issue #320). Заводится в админке, прикрепляется к рассылке, и один опрос
/// может уйти несколькими рассылками.
///
/// Черновик правится целиком. После отправки рассылки опрос замораживается (`frozen_at`):
/// вопросы, варианты и тексты не правятся — ответы до и после правки несравнимы. У замороженного
/// правятся только название и дата окончания; всё остальное — копией в новый черновик.
///
/// Тексты — на двух языках обязательно: опрос — не объявление, и вопрос без перевода половина
/// водителей не прочитает. Черновик хранит пустые поля; у замороженного пустых нет — проверкой
/// `surveys_frozen_complete_check` на этой строке и триггером на тексты вопросов и вариантов.
model Survey {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Служебное название для списка. Водителю не уходит. Пусто только у черновика.
  title            String?
  /// Экран открытия опроса.
  introRu          String?   @map("intro_ru")
  introUz          String?   @map("intro_uz")
  /// Экран финала.
  finishRu         String?   @map("finish_ru")
  finishUz         String?   @map("finish_uz")
  /// Кнопка отказа на экране открытия — «Закрыть», «Не интересует», как напишут.
  declineButtonRu  String?   @map("decline_button_ru")
  declineButtonUz  String?   @map("decline_button_uz")
  /// Кнопка перехода в приложение на финале.
  appButtonRu      String?   @map("app_button_ru")
  appButtonUz      String?   @map("app_button_uz")
  /// Баллы за пройденный опрос. Ноль — опрос без награды.
  points           Int       @default(0)
  /// Последний день опроса, календарный. Закрыт с 00:00 следующего дня по Ташкенту
  /// (docs/decisions.md → «Сутки — с 00:00 до 00:00 по Ташкенту; у акции — свои, с 05:00»).
  /// Пусто только у черновика.
  endsOn           DateTime? @map("ends_on") @db.Date
  /// Когда заморожен. Пусто — черновик, правится целиком. Ставит запуск рассылки с опросом.
  frozenAt         DateTime? @map("frozen_at") @db.Timestamptz(6)
  /// Демо-опрос — как у рассылки (issue #212): ставится при заведении и не меняется, копия
  /// наследует. Править демо-опрос может только владелец.
  isDemo           Boolean   @default(false) @map("is_demo")
  createdById      String    @map("created_by_id") @db.Uuid
  /// Когда завершён досрочно — кнопкой «Завершить опрос» (issue #348). Пусто — не завершался.
  /// Ставится один раз и не снимается; последний день при этом не трогается. Завершается только
  /// замороженный — проверкой `surveys_finished_check`.
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Кто завершил. Заполнен ровно тогда, когда `finished_at`.
  finishedById     String?   @map("finished_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy  Employee         @relation("survey_created_by", fields: [createdById], references: [id])
  finishedBy Employee?        @relation("survey_finished_by", fields: [finishedById], references: [id], onDelete: Restrict)
  questions SurveyQuestion[]
  mailings  Mailing[]
  responses SurveyResponse[]

  @@index([createdAt(sort: Desc)])
  @@map("surveys")
  @@schema("xb")
}

/// Вопрос опроса. Порядок — `position`, пара с опросом уникальна. Удаление черновика опроса
/// уносит вопросы.
model SurveyQuestion {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId       String             @map("survey_id") @db.Uuid
  position       Int
  type           SurveyQuestionType
  textRu         String?            @map("text_ru")
  textUz         String?            @map("text_uz")
  required       Boolean            @default(true)
  /// «Свой вариант»: водитель может вписать ответ своими словами (issue #335). Только
  /// у `single` и `multiple` — проверкой `survey_questions_own_answer_check`.
  allowOwnAnswer Boolean            @default(false) @map("allow_own_answer")

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options SurveyOption[]
  answers SurveyAnswer[]

  @@unique([surveyId, position])
  @@map("survey_questions")
  @@schema("xb")
}

/// Вариант ответа — только у `single` и `multiple`: у шкалы значения 1–5 фиксированы,
/// у текста вариантов нет. Удаление вопроса уносит его варианты.
model SurveyOption {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  position   Int
  textRu     String? @map("text_ru")
  textUz     String? @map("text_uz")
  /// Исключающий вариант — «Такого не было»: отметка снимает остальные (issue #335). Бывает
  /// только у `multiple`; `CHECK` типа вопроса из соседней таблицы не видит, и правило держит
  /// разбор тела ручки.
  exclusive  Boolean @default(false)

  question SurveyQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  SurveyAnswerOption[]

  @@unique([questionId, position])
  @@map("survey_options")
  @@schema("xb")
}

/// Прохождение опроса человеком (issue #323) — строка на пару «опрос + человек». Пара —
/// первичный ключ, и он же держит от второй строки при двойном открытии.
///
/// Метки воронки ставятся по одному разу, условием «ещё пусто»: повторное нажатие метку
/// не сдвигает. Воронка считается по людям, а не по нажатиям, поэтому
/// журнала нажатий нет.
///
/// Строка заводится первым открытием опроса, поэтому `opened_at` не пуст никогда.
model SurveyResponse {
  surveyId     String    @map("survey_id") @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  /// Первое открытие опроса.
  openedAt     DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  /// Нажата кнопка отказа на экране открытия. Начать опрос после отказа можно — метка
  /// остаётся, какой была.
  declinedAt   DateTime? @map("declined_at") @db.Timestamptz(6)
  /// Первый сохранённый ответ.
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  /// Опрос пройден. Ставится одной транзакцией с баллами за опрос (`awardSurveyPoints`).
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  /// Нажата кнопка перехода в приложение на финале.
  appClickedAt DateTime? @map("app_clicked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  survey  Survey         @relation(fields: [surveyId], references: [id])
  person  Person         @relation(fields: [personId], references: [id])
  answers SurveyAnswer[]

  @@id([surveyId, personId])
  @@index([personId])
  @@map("survey_responses")
  @@schema("xb")
}

/// Ответ человека на вопрос опроса (issue #323). Ответ на вопрос у человека один: повторная
/// отправка его заменяет, пока опрос не пройден.
///
/// Значение — в колонке по типу вопроса: `text_value` у `text`, `scale_value` у `scale`,
/// `own_text` («Свой вариант») у `single` и `multiple`, выбранные варианты — строками
/// `survey_answer_options`. Строка без значения — пропущенный необязательный вопрос: человек
/// его видел и прошёл мимо, а не бросил опрос на нём. Тип вопроса лежит в соседней таблице,
/// и соответствие значения типу держит сервис сохранения ответа.
model SurveyAnswer {
  surveyId   String  @map("survey_id") @db.Uuid
  personId   String  @map("person_id") @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  /// Свободный ответ, до 300 знаков.
  textValue  String? @map("text_value")
  /// Оценка 1–5.
  scaleValue Int?    @map("scale_value") @db.SmallInt
  /// «Свой вариант», до 300 знаков. Только у вопроса с `allow_own_answer`.
  ownText    String? @map("own_text")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  response SurveyResponse       @relation(fields: [surveyId, personId], references: [surveyId, personId], onDelete: Cascade)
  question SurveyQuestion       @relation(fields: [questionId], references: [id])
  options  SurveyAnswerOption[]

  @@id([surveyId, personId, questionId])
  @@map("survey_answers")
  @@schema("xb")
}

/// Выбранный вариант ответа у вопросов `single` и `multiple` (issue #323). Замена ответа
/// уносит прежние варианты каскадом.
model SurveyAnswerOption {
  surveyId   String @map("survey_id") @db.Uuid
  personId   String @map("person_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  optionId   String @map("option_id") @db.Uuid

  answer SurveyAnswer @relation(fields: [surveyId, personId, questionId], references: [surveyId, personId, questionId], onDelete: Cascade)
  option SurveyOption @relation(fields: [optionId], references: [id])

  @@id([surveyId, personId, questionId, optionId])
  @@map("survey_answer_options")
  @@schema("xb")
}

// ---------------------------------------------------------------------------
// Сегменты
// ---------------------------------------------------------------------------

/// Сегмент водителей: сохранённые условия отбора, а не люди (issue #165).
///
/// Состав берётся запросом в тот момент, когда понадобился: давность «20–90 дней» ползёт
/// каждый день, и сохранённый список к концу недели описывал бы других людей. Замораживает
/// состав тот, кому нужна неподвижность, — своим снимком. Отбор собирает один построитель
/// (`server/repositories/segments.ts`), и экран, и потребитель берут состав из него.
///
/// Условия — явными колонками, а не `jsonb`: колонка с разнородным содержимым не проверяется
/// ни типом, ни запросом. Склейка только «и», пустое условие в отбор не входит. Хотя бы одно
/// условие задано всегда — проверкой в миграции: сегмент без условий — это весь реестр парка
/// под видом среза.
///
/// Сегмент-список (issue #356) — исключение: людей он хранит, строками `segment_members`,
/// и условий у него нет. Заводится только из итогов опроса, состав фиксируется в момент
/// заведения. Отбор у него тот же построитель — по реестру, с признаком демо и без спрятанных.
///
/// Не удаляется, а архивируется: на сегмент ссылаются рассылки и акции, и удалённый унёс бы
/// ответ на вопрос «кого мы тогда звали».
model Segment {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  /// Для сотрудников: зачем срез и кого он должен брать. Водителю не уходит.
  description String?

  /// Календарные сутки по Ташкенту с последней завершённой поездки — не меньше. Задано хотя бы
  /// одна граница — человек без единой завершённой поездки в состав не входит: «не ездил» —
  /// не «давно ездил».
  daysSinceTripMin Int?     @map("days_since_trip_min")
  /// Календарные сутки по Ташкенту с последней завершённой поездки — не больше.
  daysSinceTripMax Int?     @map("days_since_trip_max")
  /// Участник программы — есть строка `person_settings` — или нет.
  programMember    Boolean? @map("program_member")
  /// Активная привязка Telegram — есть или нет.
  telegramLinked   Boolean? @map("telegram_linked")
  /// Баланс водительского счёта — не меньше. Человек без счёта под условие не подходит.
  balanceMin       BigInt?  @map("balance_min")
  /// Баланс водительского счёта — не больше.
  balanceMax       BigInt?  @map("balance_max")
  /// Чем задан сегмент (issue #356). У списка все колонки условий пусты — проверкой
  /// `segments_list_without_conditions_check`: состав — строки `segment_members`.
  kind             SegmentKind @default(conditions)

  createdById String    @map("created_by_id") @db.Uuid
  /// Заполнено — сегмент убран из обращения: при выборе не предлагается, по ссылке открывается.
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy  Employee    @relation(fields: [createdById], references: [id])
  members    SegmentMember[]
  campaigns  Campaign[]
  mailings   Mailing[]
  /// Демо-сегмент (issue #212): отбирает только демо-водителей, живой — только живых.
  /// Признак — часть отбора (`segmentMembersSql`), а не условие формы: условий у сегмента
  /// по-прежнему хотя бы одно. Ставится при заведении и не меняется.
  isDemo      Boolean   @default(false) @map("is_demo")
  giftGrants GiftGrant[]

  @@map("segments")
  @@schema("xb")
}

/// Человек сегмента-списка (issue #356). Пишется один раз, при заведении списка, и больше
/// не меняется ничем: список не пересчитывается.
model SegmentMember {
  segmentId String   @map("segment_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  /// `Restrict`: человек из списка не исчезает молча — список говорит, кого тогда взяли.
  person  Person  @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([segmentId, personId])
  @@map("segment_members")
  @@schema("xb")
}

// ---------------------------------------------------------------------------
// Акции
// ---------------------------------------------------------------------------

/// Акция: окно, в котором снимок участников из сегмента играет по механике (issue #166).
///
/// Состав снимается из сегмента один раз, при запуске, и больше не пересчитывается ничем:
/// давность «20–90 дней» ползёт каждый день, и без заморозки к концу окна в волне оказались
/// бы другие люди. Снимок — строки `campaign_participants`.
///
/// Согласованность статуса с полями держится проверкой в миграции: у запущенной есть
/// название, `slug`, сегмент, время запуска и размер снимка, офис выдачи наград и их срок;
/// у черновика нет ни запуска, ни снимка.
model Campaign {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Короткое латинское имя, `comeback-wave-1`. От него строится ключ идемпотентности
  /// массовых операций акции (docs/points.md → `campaign:<slug>:<persons.id>`), поэтому
  /// уникально и после запуска не меняется. Пусто только у черновика.
  slug         String?        @unique
  /// Название для людей. Пусто только у черновика.
  title        String?
  status       CampaignStatus
  /// Сегмент, из которого снят состав. Обязателен у запущенной.
  segmentId    String?        @map("segment_id") @db.Uuid
  /// Делили ли состав на половины: половина Б — контроль, её приглашают позже своим окном.
  splitEnabled Boolean        @default(false) @map("split_enabled")
  /// Сколько человек попало в снимок. Факт на дату запуска, а не счётчик: по нему видно,
  /// с чего волна начиналась. Пусто у черновика.
  audienceSize Int?           @map("audience_size")
  /// Офис выдачи наград акции: призы лежат и выдаются в одном офисе. Обязателен у запущенной.
  officeId           String? @map("office_id") @db.Uuid
  /// Через сколько дней сгорает неполученная награда. Обязателен у запущенной.
  rewardLifetimeDays Int?    @map("reward_lifetime_days")
  createdById  String         @map("created_by_id") @db.Uuid
  launchedAt   DateTime?      @map("launched_at") @db.Timestamptz(6)
  /// Демо-акция (issue #212): только на демо-сегменте и с ДЕМО ОФИСОМ выдачи, живая — только
  /// на живом сегменте, с живым офисом и без демо-товаров в призах. Идёт тем же кодом, что
  /// живая. Ставится при заведении и не меняется.
  isDemo       Boolean        @default(false) @map("is_demo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// `Restrict`, а не умолчание `SetNull` у необязательной связи: сегмент не удаляется
  /// (архив), а удалённый не должен молча стирать ответ «из кого снят состав».
  segment      Segment?              @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  /// `Restrict` тем же доводом, что у сегмента: офис не удаляется (архив).
  office       Office?               @relation(fields: [officeId], references: [id], onDelete: Restrict)
  createdBy    Employee              @relation(fields: [createdById], references: [id])
  halves       CampaignHalf[]
  participants CampaignParticipant[]
  rewards      Reward[]
  prizes       CampaignPrize[]

  @@index([createdAt(sort: Desc)])
  @@map("campaigns")
  @@schema("xb")
}

/// Окно половины. Стоит на половине, а не на акции: половины стартуют с разницей в неделю,
/// и одной пары дат на акцию не хватает.
///
/// Сотрудник вводит даты, храним метки: сутки акции идут с 05:00 до 05:00 по Ташкенту,
/// и окно «1–7 октября» — это `01.10 05:00` … `08.10 05:00` (`promoDayStartSql`, `server/utils/parkDaySql.ts`).
/// Начало входит в окно, конец — нет.
///
/// Строка `a` есть у каждой акции с заведения. Строка `b` — только при делении, и её даты
/// пусты, пока до половины не дошла очередь.
model CampaignHalf {
  campaignId String           @map("campaign_id") @db.Uuid
  half       CampaignHalfCode
  startsAt   DateTime?        @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime?        @map("ends_at") @db.Timestamptz(6)

  campaign     Campaign              @relation(fields: [campaignId], references: [id])
  participants CampaignParticipant[]

  @@id([campaignId, half])
  @@map("campaign_halves")
  @@schema("xb")
}

/// Снимок состава и состояние водителя в акции.
///
/// Пара «акция + человек» — первичный ключ, и это защита от второго снимка: повтор запуска
/// вторых строк не заведёт, ровно как у `mailing_recipients`. Переходы состояния пишутся
/// условием на прежнее состояние внутри `UPDATE`.
model CampaignParticipant {
  campaignId String                   @map("campaign_id") @db.Uuid
  personId   String                   @map("person_id") @db.Uuid
  /// Заполнена всегда. Без деления — `a` у всех.
  half       CampaignHalfCode
  state      CampaignParticipantState
  openedAt   DateTime?                @map("opened_at") @db.Timestamptz(6)
  joinedAt   DateTime?                @map("joined_at") @db.Timestamptz(6)
  declinedAt DateTime?                @map("declined_at") @db.Timestamptz(6)
  /// Исход окна. Пусто, пока итог не подведён. Проставлен — экран рисуется из снимка ниже
  /// и не считает ничего: опоздавшая поездка не должна разойтись с объявленным итогом.
  outcome       CampaignParticipantOutcome?
  outcomeAt     DateTime?                   @map("outcome_at") @db.Timestamptz(6)
  /// Сколько зачётных дней вышло на момент итога. Факт, а не счётчик: по нему считается
  /// эффект волны и видно, кто на сколько не дотянул.
  qualifiedDays Int?                        @map("qualified_days")
  /// Зачитанные поездки по дням окна на момент итога — из них рисуются клетки замершей недели.
  dayTrips      Int[]                       @map("day_trips")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign Campaign     @relation(fields: [campaignId], references: [id])
  person   Person       @relation(fields: [personId], references: [id])
  /// Окно половины участника. Внешним ключом, а не договорённостью: участник, чьей половины
  /// нет в `campaign_halves`, выпал бы из каждого соединения с окном — акции не видел бы,
  /// а в админке числился бы обычным приглашённым (ревью #170).
  window   CampaignHalf @relation(fields: [campaignId, half], references: [campaignId, half], onDelete: Restrict, onUpdate: Cascade)
  chests   CampaignChest[]

  @@id([campaignId, personId])
  /// Разбивка по состояниям и половинам на карточке акции.
  @@index([campaignId, half, state])
  /// Разбивка по исходам на карточке акции.
  @@index([campaignId, half, outcome])
  /// Что у водителя с акцией — при каждом открытии Mini App.
  @@index([personId])
  @@map("campaign_participants")
  @@schema("xb")
}

/// Открытый сундук акции (issue #181) — строка на открытие, а не на заработанный сундук.
///
/// Заработан ли сундук, не хранится: это считается от журнала поездок, как зачётный день, —
/// опоздавшая из Fleet API поездка дозачтёт вчерашний день и его сундук сама.
///
/// Сундук принадлежит участию, а не человеку вообще: внешний ключ на пару «акция + человек».
/// Второе открытие держит база, а не проверка в коде: частичные уникальные индексы в миграции —
/// день окна у сундука дня, ступень у остальных. `day_number` заполнен только у сундука дня —
/// проверкой там же.
model CampaignChest {
  id         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String                  @map("campaign_id") @db.Uuid
  personId   String                  @map("person_id") @db.Uuid
  kind       CampaignChestKind
  /// Номер дня окна, с единицы. Только у сундука дня.
  dayNumber  Int?                    @map("day_number")
  openedAt   DateTime                @default(now()) @map("opened_at") @db.Timestamptz(6)
  openedBy   CampaignChestOpenSource @map("opened_by")
  /// Что выпало. У сундука награда одна, и одна награда — не больше чем из одного сундука.
  rewardId   String                  @unique @map("reward_id") @db.Uuid

  participant CampaignParticipant @relation(fields: [campaignId, personId], references: [campaignId, personId], onDelete: Restrict)
  /// `Restrict`, как у остальных ссылок на награду: удалённая награда стёрла бы ответ «что выпало».
  reward      Reward              @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@map("campaign_chests")
  @@schema("xb")
}

/// Вариант приза сундука акции (issue #180): чем наполнен сундук и с каким весом разыгрывается.
///
/// Наполнение — данные акции, а не код: что лежит в сундуке, решается с парком от акции
/// к акции. Вид — тот же `reward_kind`, что у награды, и поля значения те же: строка приза
/// превращается в награду без домысливания.
///
/// У сундука дня вариантов сколько угодно, выпадает по весу. У сундуков трёх дней и недели
/// вариант один — частичным уникальным индексом в миграции: второй означал бы розыгрыш там,
/// где его нет. Согласованность полей с видом и положительный вес — проверками там же.
///
/// Набор правится только у черновика и только целиком: у идущей акции часть водителей уже
/// открыла сундуки по прежним весам.
model CampaignPrize {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String            @map("campaign_id") @db.Uuid
  chest      CampaignChestKind
  kind       RewardKind
  /// Вес в розыгрыше сундука дня. Доля варианта — вес, делённый на сумму весов сундука.
  /// У фиксированных сундуков единица: делить нечего.
  weight     Int
  /// Только у баллов.
  points     Int?
  /// Только у товара.
  productId  String?           @map("product_id") @db.Uuid
  /// Только у произвольной.
  title      String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  /// `Restrict`, как у `rewards.product_id`: товар не удаляется, а удалённый молча стёр бы
  /// ответ «что разыгрывали».
  product  Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([campaignId, chest])
  @@index([productId])
  @@map("campaign_prizes")
  @@schema("xb")
}

// ---------------------------------------------------------------------------
// Награды
// ---------------------------------------------------------------------------

/// Награда водителю: баллы, товар из каталога или произвольная (issue #172).
///
/// Своя сущность, а не заказ: у заказа обязательно списание баллов и офис, выбранный водителем,
/// позиция ссылается на товар витрины, а срок — это срок резерва. У награды списания нет, офис
/// приходит от акции или сотрудника, товар может быть вне каталога, срок свой.
///
/// Появляется только через `grantReward`. Привязана к человеку, а не к учётке парка и не
/// к участию в акции: баланс и награды принадлежат человеку.
///
/// Согласованность полей с видом и статусом держится проверками в миграции: у баллов пусты
/// код, офис и срок и заполнены баллы; у товара — товар и офис; у `issued` — время
/// и сотрудник выдачи; у `expired` — время сгорания.
model Reward {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId String       @map("person_id") @db.Uuid
  kind     RewardKind
  /// Что написано водителю и на карточке стойки. Заполнено всегда, в том числе у товара:
  /// название товара меняется, а выданная награда помнит, что выдавали, — тем же доводом,
  /// что `order_items.unit_points`.
  title    String
  /// Только у баллов.
  points   Int?
  /// Только у товара.
  productId String?     @map("product_id") @db.Uuid
  /// Себестоимость товара в сумах на момент создания награды, дальше живёт своей жизнью
  /// от цены каталога (issue #372). Только у товара — проверкой в миграции; пусто и у товара
  /// без себестоимости. Награды до снимка заполнены ценой каталога на день, когда снимок заведён.
  cost      Int?

  /// Где получать. Обязателен у товара и произвольной, пуст у баллов.
  officeId  String?     @map("office_id") @db.Uuid
  /// Пять цифр для стойки, первая — 5–9: диапазон заказов 0–4 с ним не пересекается.
  /// Уникален среди `awaiting` частичным индексом. Пуст у баллов.
  code      String?
  status    RewardStatus
  /// Когда неполученная сгорает. Пуст у баллов: сгорать нечему.
  expiresAt DateTime?   @map("expires_at") @db.Timestamptz(6)

  issuedAt           DateTime? @map("issued_at") @db.Timestamptz(6)
  issuedByEmployeeId String?   @map("issued_by_employee_id") @db.Uuid
  expiredAt          DateTime? @map("expired_at") @db.Timestamptz(6)

  source     RewardSource
  /// Акция, если источник `campaign`.
  campaignId String?      @map("campaign_id") @db.Uuid
  /// Откуда внутри источника: «Сундук дня, день 3». Текстом, а не ссылкой на сундук: карточка
  /// стойки читает его как есть, у ручной выдачи сундука нет, а связь с сундуком держит
  /// `campaign_chests.reward_id`.
  sourceNote String?      @map("source_note")
  /// «Почему» на узбекском — у ручной награды-товара и произвольной (issue #266). Водитель
  /// на узбекском видит его, стойка и карточка водителя в вебе — русское `source_note`.
  sourceNoteUz String?    @map("source_note_uz")
  /// Свой текст сообщения о ручной награде на каждом языке (issue #266). Пусто — водителю
  /// этого языка уходит системный текст.
  messageRu    String?    @map("message_ru")
  messageUz    String?    @map("message_uz")
  /// Обложки сообщения и шторки на каждом языке — пути на томе, `gifts/<id награды>-ru.<ext>`,
  /// рядом с обложками подарков. Обе или ни одной.
  coverRuPath  String?    @map("cover_ru_path")
  coverUzPath  String?    @map("cover_uz_path")
  /// Кто вручил — у источников `manual` и `gift`.
  grantedByEmployeeId String? @map("granted_by_employee_id") @db.Uuid

  /// Раздача, из которой родился подарок, — у источника `gift` (issue #219).
  giftGrantId String?        @map("gift_grant_id") @db.Uuid
  /// Когда подарок лёг на баланс. Заполнено только у зачисленного подарка.
  claimedAt   DateTime?      @map("claimed_at") @db.Timestamptz(6)
  /// Забрал сам или зачислилось по сроку — вместе с `claimed_at`.
  claimMode   GiftClaimMode? @map("claim_mode")
  /// Водитель видел шторку с этой наградой: второй раз сама она не показывается. Есть
  /// у подарка и у ручной награды-товара и произвольной (issue #266).
  giftShownAt DateTime?      @map("gift_shown_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  person           Person    @relation(fields: [personId], references: [id])
  // `Restrict`, а не умолчание `SetNull` у необязательной связи: товар, офис и акция
  // не удаляются, а удалённый молча стёр бы у награды ответ «что и где выдавали».
  product          Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)
  office           Office?   @relation(fields: [officeId], references: [id], onDelete: Restrict)
  campaign         Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  issuedByEmployee Employee? @relation("reward_issued_by", fields: [issuedByEmployeeId], references: [id])
  grantedByEmployee Employee? @relation("reward_granted_by", fields: [grantedByEmployeeId], references: [id])
  giftGrant         GiftGrant? @relation(fields: [giftGrantId], references: [id], onDelete: Restrict)

  movements StockMovement[]
  chest     CampaignChest?

  /// Список водителя, свежие первыми.
  @@index([personId, createdAt(sort: Desc)])
  /// Что ждёт в офисе.
  @@index([officeId, status])
  /// Разбор волны в админке.
  @@index([campaignId])
  /// Одна награда на человека в раздаче; по нему же считаются исходы раздачи в списке.
  @@unique([giftGrantId, personId])
  @@map("rewards")
  @@schema("xb")
}

/// Раздача подарка от Xalq Taxi: баллы одному водителю или сегменту (issue #219).
///
/// Награды раздачи рождаются `claimable` и ложатся на баланс, когда водитель забирает их
/// сам или наступает `until_date`. Журнал баллов пишется в момент зачисления, а не раздачи,
/// причиной `campaign` с ключом `campaign:gift-<gift_grants.id>:<persons.id>` (docs/points.md).
///
/// Состав сегмента снимается на момент раздачи и дальше не пересчитывается — как у запуска
/// акции: сколько наград родилось и скольких пропустили, помнят `recipients` и `skipped`.
///
/// Получатель ровно один — водитель или сегмент — проверкой в миграции.
model GiftGrant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  points      Int
  /// Повод, который видит водитель, на его языке: «ко Дню учителя». Оба языка обязательны —
  /// сообщение и приложение говорят с водителем на его языке (правка по прогону #232).
  reasonRu    String   @map("reason_ru")
  reasonUz    String   @map("reason_uz")
  /// День автозачисления в зоне парка: незабранное ложится на баланс в конце этих суток.
  untilDate   DateTime @map("until_date") @db.Date
  /// Обложки на каждом языке — относительные пути на томе, `gifts/<id>-ru.<ext>` и `gifts/<id>-uz.<ext>`
  /// (у раздач до #236 — общий `gifts/<id>.<ext>` в обеих). Обе или ни одной: пусто — без обложки.
  coverRuPath String?  @map("cover_ru_path")
  coverUzPath String?  @map("cover_uz_path")
  /// Свой текст сообщения на каждом языке (#236). Пусто — водителю этого языка уходит системный текст.
  messageRu   String?  @map("message_ru")
  messageUz   String?  @map("message_uz")

  segmentId String? @map("segment_id") @db.Uuid
  personId  String? @map("person_id") @db.Uuid

  /// Сколько наград родилось.
  recipients Int
  /// Сколько человек из сегмента пропущено: не участники программы.
  skipped    Int

  grantedByEmployeeId String   @map("granted_by_employee_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  segment           Segment? @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  person            Person?  @relation(fields: [personId], references: [id], onDelete: Restrict)
  grantedByEmployee Employee @relation(fields: [grantedByEmployeeId], references: [id])
  rewards           Reward[]

  /// Список раздач, свежие первыми.
  @@index([createdAt(sort: Desc)])
  @@map("gift_grants")
  @@schema("xb")
}

/// История заказов парка — для анализа оттока, а не для начисления (issue #315).
///
/// Отдельно от `trips` намеренно: запись в `trips` через `syncOrders` начисляет баллы
/// (`trip:<order_id>`), и прогон за год начислил бы баллы за год. Здесь начислений,
/// отметок синхронизации и `sync_skips` нет.
///
/// Внешнего ключа на `park_profiles` нет: в истории лежат заказы профилей, которых нет
/// в нашем реестре, — они-то и нужны больше всего.
model FleetOrderHistory {
  orderId       String    @id @map("order_id")
  profileId     String    @map("profile_id")
  status        String
  category      String
  paymentMethod String    @map("payment_method")
  workRuleId    String?   @map("work_rule_id")
  bookedAt      DateTime  @map("booked_at") @db.Timestamptz(6)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(6)
  price         Decimal   @db.Decimal(12, 2)
  carCallsign   String?   @map("car_callsign")
  fetchedAt     DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@index([profileId, endedAt])
  @@index([endedAt])
  @@map("fleet_order_history")
  @@schema("xb")
}

/// Журнал сборщика истории: строка на обойдённые сутки сбора.
///
/// По нему полный прогон продолжается с места остановки. `finished_at = null` —
/// обход суток прервался. Строка заводится в начале обхода, только если её ещё нет, и
/// закрывается итогами в конце успешного обхода; оборванный повтор закрытые сутки не трогает.
/// У незакрытых суток итоги и курсор пишутся после каждой страницы, в одной транзакции
/// с её заказами (issue #328).
model FleetOrderHistoryDay {
  /// Сутки сбора по UTC `D`: `ended_at` с `D 00:00:00Z` по `D+1 00:00:00Z` — порция загрузки,
  /// а не сутки метрик.
  parkDay     DateTime  @id @map("park_day") @db.Date
  orders      Int
  complete    Int
  malformed   Int
  pages       Int
  rateLimited Int       @map("rate_limited")
  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Курсор Fleet API на страницу, следующую за последней записанной: с него оборванные
  /// сутки продолжаются. Пуст у закрытых суток и у суток, не прошедших ни одной страницы.
  nextCursor  String?   @map("next_cursor")

  @@map("fleet_order_history_days")
  @@schema("xb")
}

/// Справочник категорий транзакций парка из Fleet (issue #358).
///
/// Обновляется целиком в начале каждого прогона истории транзакций и каждого ночного
/// перечитывания. Словарь чужой, поэтому таблица, а не перечисление (docs/decisions.md →
/// «Перечисления заводим только на свои словари»).
model FleetTransactionCategory {
  id                       String   @id
  name                     String
  groupId                  String   @map("group_id")
  groupName                String   @map("group_name")
  isEnabled                Boolean  @map("is_enabled")
  isAffectingDriverBalance Boolean  @map("is_affecting_driver_balance")
  updatedAt                DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("fleet_transaction_categories")
  @@schema("xb")
}

/// Транзакция парка из Fleet — все категории, без фильтра (issue #358): деньги парка
/// и деньги платформы. Повтор той же транзакции обновляет строку по `id`, а не дублирует её.
///
/// Внешнего ключа на справочник категорий нет: категория может прийти раньше, чем справочник
/// её узнает. На `park_profiles` и заказы — тоже нет: транзакции лежат и за профили, и за заказы,
/// которых у нас нет.
model FleetTransaction {
  id                  String   @id
  eventAt             DateTime @map("event_at") @db.Timestamptz(6)
  categoryId          String   @map("category_id")
  /// Со знаком, как в Fleet: комиссия парка отрицательная.
  amount              Decimal  @db.Decimal(18, 4)
  /// Пусто, если Fleet его не прислал: транзакция с деньгами пишется и без служебного поля.
  currencyCode        String?  @map("currency_code")
  driverProfileId     String?  @map("driver_profile_id")
  orderId             String?  @map("order_id")
  /// Поле `external_event_id` ответа. В документации Fleet описано `event_id`, но в живых
  /// ответах его нет ни разу — приходит `external_event_id` (проба 04-10-2026).
  externalEventId     String?  @map("external_event_id")
  description         String?
  /// `identity` из `created_by`: `platform`, `dispatcher`, `tech-support`, `fleet-api`.
  /// Пусто, если Fleet его не прислал.
  createdBy           String?  @map("created_by")
  /// `dispatcher_name`, когда транзакцию создал диспетчер.
  createdByDispatcher String?  @map("created_by_dispatcher")
  fetchedAt           DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([eventAt])
  @@index([driverProfileId, eventAt])
  @@index([categoryId, eventAt])
  @@map("fleet_transactions")
  @@schema("xb")
}

/// Журнал сборщика истории транзакций: строка на обойдённые сутки сбора — как
/// `fleet_order_history_days`. Живой сбор и ночное перечитывание его не трогают.
model FleetTransactionDay {
  /// Сутки сбора по UTC `D`: `event_at` с `D 00:00:00Z` по `D+1 00:00:00Z` — порция загрузки,
  /// а не сутки метрик.
  parkDay      DateTime  @id @map("park_day") @db.Date
  transactions Int
  malformed    Int
  pages        Int
  rateLimited  Int       @map("rate_limited")
  startedAt    DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Курсор Fleet API на страницу, следующую за последней записанной: с него оборванные
  /// сутки продолжаются. Пуст у закрытых суток и у суток, не прошедших ни одной страницы.
  nextCursor   String?   @map("next_cursor")

  @@map("fleet_transaction_days")
  @@schema("xb")
}

/// Поездки человека за сутки — готовая таблица ночного пересчёта метрик дашборда (issue #371).
///
/// Считается целиком заново (`server/services/metrics/recomputePersonDays.ts`), а не добавкой:
/// история заказов догружается задним числом, и добавка пропустила бы дозакрытые сутки.
/// Водитель — человек, а не учётная запись парка; поездка — завершённый заказ из `trips`
/// и `fleet_order_history` (docs/decisions.md → «Метрики дашборда»). Строк без поездок нет:
/// человек, не ездивший в сутки, в них отсутствует. Демо-людей нет.
model MetricPersonDay {
  /// Сутки по Ташкенту, календарные.
  day      DateTime @db.Date
  personId String   @map("person_id") @db.Uuid
  /// Завершённых поездок человека за эти сутки, больше нуля.
  trips    Int

  person Person @relation(fields: [personId], references: [id])

  @@id([day, personId])
  @@index([personId, day])
  @@map("metric_person_days")
  @@schema("xb")
}

/// Поездки человека до истории заказов (issue #429): последние сутки с комиссией парка
/// `partner_ride_fee` раньше `METRICS_FIRST_DAY`. По ним «новый» в потоке и новичок отличаются
/// от вернувшегося после долгого перерыва (docs/decisions.md → «Поток водителей — по календарному
/// месяцу»). Считается тем же пересчётом и в той же транзакции, что `metric_person_days`; демо-людей нет.
model MetricPersonPrior {
  personId String   @id @map("person_id") @db.Uuid
  /// Последние сутки по Ташкенту с комиссией раньше `METRICS_FIRST_DAY`.
  lastDay  DateTime @map("last_day") @db.Date

  person Person @relation(fields: [personId], references: [id])

  @@map("metric_person_prior")
  @@schema("xb")
}

/// Журнал прогонов пересчёта метрик (issue #371): по нему экран говорит, когда посчитано,
/// а разбор видит, что прогон шёл. `finished_at = null` — идёт или упал; у упавшего — `error`.
model MetricRecomputeRun {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Первые и последние сутки пересчёта, по Ташкенту.
  daysFrom           DateTime  @map("days_from") @db.Date
  daysTo             DateTime  @map("days_to") @db.Date
  /// Строк `metric_person_days` записано.
  rows               Int?
  /// Завершённых заказов истории, у чьего профиля нет записи в `park_profiles`: человека
  /// у них нет, и в таблицу они не попадают.
  unattributedOrders Int?      @map("unattributed_orders")
  error              String?

  @@index([finishedAt])
  @@map("metric_recompute_runs")
  @@schema("xb")
}

/// Деньги парка за сутки — готовая таблица вкладки «Деньги» (issue #438), из транзакций Fleet.
///
/// Строка на каждые сутки от `MONEY_FIRST_DAY` по последние посчитанные, в том числе с нулями:
/// пустые сутки — тоже ответ. Считается целиком заново после ночного перечитывания транзакций
/// (`server/services/metrics/recomputeMoneyDays.ts`), экран читает только её (docs/decisions.md →
/// «Деньги на дашборде»).
model MetricMoneyDay {
  /// Сутки по Ташкенту, календарные: `event_at AT TIME ZONE 'Asia/Tashkent'`.
  day     DateTime @id @db.Date
  /// Строк комиссии парка `partner_ride_fee` — оплаченных заказов: у каждого комиссия одна.
  orders  Int
  /// Доход парка, сум: комиссия с обратным знаком — в транзакции она со знаком баланса водителя.
  income  Decimal  @db.Decimal(18, 4)
  /// Оплата заказов, сум: платёжные категории как есть, без чаевых.
  payment Decimal  @db.Decimal(18, 4)

  @@map("metric_money_days")
  @@schema("xb")
}

/// Журнал прогонов пересчёта денег (issue #438), как `MetricRecomputeRun`: по нему экран
/// говорит, когда посчитано и по какие сутки. `finished_at = null` — идёт или упал; у упавшего — `error`.
model MetricMoneyRun {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Первые и последние сутки пересчёта, по Ташкенту.
  daysFrom        DateTime  @map("days_from") @db.Date
  daysTo          DateTime  @map("days_to") @db.Date
  /// Строк `metric_money_days` записано.
  rows            Int?
  /// Строк `metric_person_months` записано (issue #442).
  personMonthRows Int?      @map("person_month_rows")
  error           String?

  @@index([finishedAt])
  @@map("metric_money_runs")
  @@schema("xb")
}

/// Деньги человека за месяц — готовая таблица плитки «Цена водителя за год» (issue #442),
/// из транзакций Fleet.
///
/// Строка на человека и календарный месяц по Ташкенту, в котором у него был хоть один оплаченный
/// заказ. Заказ — строка комиссии парка `partner_ride_fee` с её `order_id`; человек — через профиль
/// комиссии в реестре, комиссия без профиля в реестре сюда не идёт. Оплата заказа берётся по тому же
/// `order_id` и уходит в месяц и к человеку его комиссии. Считается целиком заново тем же прогоном
/// и в той же транзакции, что `metric_money_days` (`server/services/metrics/recomputeMoneyDays.ts`);
/// демо-людей нет (docs/decisions.md → «Цена водителя на дашборде»).
model MetricPersonMonth {
  /// Первое число календарного месяца по Ташкенту.
  month               DateTime @db.Date
  personId            String   @map("person_id") @db.Uuid
  /// Оплаченных заказов — строк комиссии парка.
  orders              Int
  /// Комиссия парка, сум: сумма комиссии с обратным знаком.
  fee                 Decimal  @db.Decimal(18, 4)
  /// Оплата этих заказов, сум: платёжные категории как есть, без чаевых.
  payment             Decimal  @db.Decimal(18, 4)
  /// То же по заказам в окне ставки новичка: сутки комиссии — с даты найма профиля
  /// по `PARK_NEWCOMER_RATE_DAYS − 1` суток после неё. Нет даты найма — заказ вне окна.
  feeNewcomerRate     Decimal  @map("fee_newcomer_rate") @db.Decimal(18, 4)
  paymentNewcomerRate Decimal  @map("payment_newcomer_rate") @db.Decimal(18, 4)

  person Person @relation(fields: [personId], references: [id])

  @@id([month, personId])
  @@index([personId])
  @@map("metric_person_months")
  @@schema("xb")
}

/// Расходы парка на найм за месяц — плитка «Окупается ли найм» на «Глубине» (issue #445).
///
/// Запись «с какого месяца действует»: сумма месяца `M` — строка с наибольшим `month` не позже `M`;
/// такой нет — расходы не заданы. Запись на тот же месяц заменяется, удаления нет: прошлые месяцы
/// считаются по своим записям (docs/decisions.md → «Окупаемость найма на дашборде»).
model DashboardHireCost {
  /// Первое число месяца, с которого действует сумма.
  month     DateTime @id @db.Date
  /// Расходы на найм за месяц, сум; больше нуля.
  amount    BigInt
  updatedBy String   @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [updatedBy], references: [id])

  @@map("dashboard_hire_costs")
  @@schema("xb")
}

// ---------------------------------------------------------------------------
// Промо-метки
// ---------------------------------------------------------------------------

/// Переход по промо-метке (issue #377): строка на каждый `/start p_<код>` — плакат, листовка,
/// QR в офисе. Пишется каждое касание, а не первое, и касание участника программы тоже:
/// уникальности нет, повторное нажатие того же QR — своя строка.
///
/// Внешнего ключа на справочник `promo_links` нет намеренно (issue #380): бот пишет касание
/// с любым годным кодом, даже если метки в справочнике нет, — касание не теряется.
model PromoTouch {
  /// Журнальная таблица, на которую никто не ссылается, — bigint identity вместо uuid,
  /// как у `telegram_link_attempts`.
  id             BigInt   @id @default(autoincrement())
  /// Код метки целиком, с префиксом: `p_poster1`.
  code           String
  /// `from.id` апдейта.
  telegramUserId BigInt   @map("telegram_user_id")
  /// `chat.id` апдейта.
  telegramChatId BigInt   @map("telegram_chat_id")
  /// Человек с живой привязкой этого Telegram на момент касания. Пусто — живой привязки не было.
  personId       String?  @map("person_id") @db.Uuid
  /// У этого Telegram на момент касания была хоть одна привязка, живая или закрытая:
  /// участник программы — хоть раз привязал Telegram (docs/decisions.md → «Баллы в метриках
  /// дашборда»).
  wasParticipant Boolean  @map("was_participant")
  touchedAt      DateTime @default(now()) @map("touched_at") @db.Timestamptz(6)

  person Person? @relation(fields: [personId], references: [id])

  /// «Сколько переходов по метке за период» — вопрос воронки раздела «Промо».
  @@index([code, touchedAt])
  /// «Что было с этим человеком» — от перехода до регистрации.
  @@index([telegramUserId, touchedAt])
  @@map("promo_touches")
  @@schema("xb")
}

/// Промо-метка (issue #380): носитель — плакат, визитка, ролик — со ссылкой в бота
/// `t.me/<бот>?start=<код>` и QR для печати. Касания по ней пишет бот в `promo_touches`.
///
/// Код — первичный ключ: он напечатан и после заведения не меняется, как и носитель.
/// Удаления нет.
model PromoLink {
  /// Код метки целиком, с префиксом: `p_poster1` (`shared/promoLinks.ts`).
  code                String      @id
  /// Видно только сотрудникам, до 80 символов.
  name                String
  medium              PromoMedium
  /// Где висит или кому раздают, до 120 символов. Пусто — ещё не записали.
  placement           String?
  /// Кто завёл. Пусто — заведена миграцией при выкате.
  createdByEmployeeId String?     @map("created_by_employee_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdByEmployee Employee? @relation(fields: [createdByEmployeeId], references: [id])

  @@map("promo_links")
  @@schema("xb")
}
